# Generated by `cox plugin new {{id}} --lang kotlin`. Every capability below
# is exactly what `--with` asked for (PL§2 shows every key this file can
# hold; docs/plugin.schema.json is its schema).
api = 1
id = "{{id}}"
version = "0.1.0"
name = "{{id}}"
description = "A cox plugin"
wasm = "{{crate_name}}.wasm"
# Kotlin's stdlib imports `random_get` from WASI; no preopens without
# [capabilities.fs].
wasi = true

[capabilities]
# cox:with=event
events = ["turn_started"]
# cox:end
# cox:with=hook
hooks = ["PostToolUse"]
# cox:end
# cox:with=tool
tools = ["hello"]
# cox:end

[capabilities.ui]
# cox:with=status
status = true
# cox:end
# cox:with=panel
panel = true
# cox:end
# cox:with=command
commands = true
# cox:end
# cox:with=key
keys = true
# cox:end
# cox:with=renderer
render = ["item:assistant_message"]
# cox:end

# cox:with=provider
[[provider]]
name = "{{id}}"
api = "plugin"
base_url = "https://example.invalid"
# cox:end

# cox:with=models
[[models]]
id = "{{id}}-model"
# cox:end

# cox:with=mcp
[[mcp]]
name = "{{id}}"
command = "mcp-server"
# cox:end
