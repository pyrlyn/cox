<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="Cox.App.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="cox">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="252" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="280" />
        </Grid.ColumnDefinitions>

        <Grid
            Background="{ThemeResource LayerFillColorDefaultBrush}"
            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
            BorderThickness="0,0,1,0"
            Padding="12,8,12,12"
            RowSpacing="8">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <TextBlock
                Style="{StaticResource CaptionTextBlockStyle}"
                Text="cox" />
            <TextBox
                Grid.Row="1"
                AutomationProperties.Name="Filter sessions"
                IsEnabled="False"
                PlaceholderText="Filter" />
            <TextBlock
                Grid.Row="2"
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                Text="Needs you" />
            <TextBlock
                Grid.Row="3"
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                Text="No sessions yet"
                TextWrapping="Wrap" />
            <Button
                Grid.Row="4"
                HorizontalAlignment="Stretch"
                AutomationProperties.Name="New session"
                Content="New session"
                IsEnabled="False" />
        </Grid>

        <Grid Grid.Column="1" RowSpacing="0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Grid
                x:Name="TitleBar"
                Height="48"
                Padding="16,0,160,0"
                ColumnSpacing="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock
                    VerticalAlignment="Center"
                    Style="{StaticResource BodyStrongTextBlockStyle}"
                    Text="No project" />
                <TextBlock
                    Grid.Column="1"
                    VerticalAlignment="Center"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Text="branch appears with the workspace" />
            </Grid>
            <StackPanel
                Grid.Row="1"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Spacing="8">
                <TextBlock
                    HorizontalAlignment="Center"
                    Style="{StaticResource TitleTextBlockStyle}"
                    Text="What should we do?" />
                <TextBlock
                    HorizontalAlignment="Center"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Text="Sessions, transcript and review land as the Windows client grows."
                    TextWrapping="Wrap" />
            </StackPanel>
            <Grid
                Grid.Row="2"
                Margin="16"
                Padding="12"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="8"
                RowSpacing="8">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <TextBox
                    AcceptsReturn="True"
                    AutomationProperties.Name="Composer"
                    IsEnabled="False"
                    MinHeight="64"
                    PlaceholderText="Ask cox…    @ files    / commands    ! shell"
                    TextWrapping="Wrap" />
                <StackPanel
                    Grid.Row="1"
                    Orientation="Horizontal"
                    Spacing="8">
                    <Button AutomationProperties.Name="Permission mode" Content="Ask" IsEnabled="False" />
                    <Button AutomationProperties.Name="Model" Content="No model" IsEnabled="False" />
                    <Button AutomationProperties.Name="Effort" Content="think" IsEnabled="False" />
                </StackPanel>
            </Grid>
        </Grid>

        <Grid
            Grid.Column="2"
            Background="{ThemeResource LayerFillColorDefaultBrush}"
            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
            BorderThickness="1,0,0,0"
            Padding="12">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <TextBlock
                Style="{StaticResource BodyStrongTextBlockStyle}"
                Text="Inspector" />
            <StackPanel Grid.Row="1" Margin="0,12,0,0" Spacing="4">
                <TextBlock Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="Changes" />
                <TextBlock Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="Plan" />
                <TextBlock Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="Context" />
                <TextBlock Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="Tasks" />
                <TextBlock Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="Info" />
            </StackPanel>
        </Grid>
    </Grid>
</Window>
