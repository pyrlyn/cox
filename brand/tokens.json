{
  "$description": "cox brand (the coxswain that steers: terminal TUI pane + chartreuse cursor). Local deltas only; extends @pyrlyn/brand base/tokens.json (pinned in package.json), built by `node build.mjs` into dist/tokens.css. Source: pyrlyn/cox@03825e72 docs/brand/tokens.css and docs/brand/DESIGN.md. Roles map cox names: bg-elevated→surface, accent-soft→accent-muted, warning→warn, shadow→shadow-e1; cox's own accent-muted (a solid mid green) is kept as accent-leaf. Keys that are not base roles become --cox-*. Added in the pack: on-accent (both themes) and the -fg text variants of the status roles, derived from the palette and checked for WCAG AA in README.md.",
  "$extends": "@pyrlyn/brand/base/tokens.json",
  "$extensions": {
    "com.pyrlyn.brand": "cox",
    "com.pyrlyn.defaultTheme": "light"
  },
  "brand": {
    "$description": "Brand constants.",
    "forest": {
      "$type": "color",
      "$value": "#0F1A14",
      "$description": "forest ink, logo tile"
    },
    "chartreuse": {
      "$type": "color",
      "$value": "#A8E06C",
      "$description": "mark stroke, dark accent"
    },
    "terminal-green": {
      "$type": "color",
      "$value": "#C8F08A",
      "$description": "terminal text"
    }
  },
  "theme": {
    "$description": "Per theme. Light is the default (cox: :root and [data-theme=\"light\"]).",
    "light": {
      "bg": {
        "$type": "color",
        "$value": "#F4F7F2",
        "$description": "page background"
      },
      "surface": {
        "$type": "color",
        "$value": "#FFFFFF",
        "$description": "cards, panels (cox: bg-elevated)"
      },
      "surface-2": {
        "$type": "color",
        "$value": "#D8E2D2",
        "$description": "hover / selected"
      },
      "surface-3": {
        "$type": "color",
        "$value": "#C5D4BC",
        "$description": "pressed"
      },
      "border": {
        "$type": "color",
        "$value": "#A8BAA0",
        "$description": "default border"
      },
      "fg": {
        "$type": "color",
        "$value": "{brand.forest}",
        "$description": "primary text"
      },
      "fg-muted": {
        "$type": "color",
        "$value": "#3D4F42",
        "$description": "secondary"
      },
      "fg-subtle": {
        "$type": "color",
        "$value": "#6A7D6E",
        "$description": "tertiary"
      },
      "accent": {
        "$type": "color",
        "$value": "#3D8B3A",
        "$description": "primary CTA"
      },
      "accent-fg": {
        "$type": "color",
        "$value": "#2F6F2C",
        "$description": "accent as text (links): = cox accent-hover. accent #3D8B3A is 3.92:1 on bg; this is >= 4.58:1 on bg, surface, surface-2"
      },
      "accent-muted": {
        "$type": "color",
        "$value": "#E2F0D8",
        "$description": "accent wash (cox: accent-soft)"
      },
      "on-accent": {
        "$type": "color",
        "$value": "#060A08",
        "$description": "text on an accent fill: near-black terminal ink (cox code-bg, dark theme), 4.70:1 on accent #3D8B3A. White is 4.24:1 and forest #0F1A14 4.20:1, both fail AA for body text"
      },
      "success": {
        "$type": "color",
        "$value": "#3D8B3A"
      },
      "success-fg": {
        "$type": "color",
        "$value": "#2F6F2C",
        "$description": "status text (= cox accent-hover); success #3D8B3A as text is 3.18:1 on surface-2. >= 4.58:1 on bg, surface, surface-2"
      },
      "warn": {
        "$type": "color",
        "$value": "#B8860B",
        "$description": "cox: warning"
      },
      "warn-fg": {
        "$type": "color",
        "$value": "#7F5D07",
        "$description": "status text, warning amber darkened; #B8860B as text is 2.44:1 on surface-2. >= 4.53:1"
      },
      "danger": {
        "$type": "color",
        "$value": "#B5403A"
      },
      "danger-fg": {
        "$type": "color",
        "$value": "#A13A34",
        "$description": "status text, danger darkened; #B5403A is 4.18:1 on surface-2. >= 4.96:1"
      },
      "mark-tile": {
        "$type": "color",
        "$value": "{brand.forest}",
        "$description": "logo tile"
      },
      "shadow-e1": {
        "$type": "shadow",
        "$value": "0 1px 2px rgba(15, 26, 20, 0.06), 0 4px 12px rgba(15, 26, 20, 0.04)",
        "$description": "cox: shadow"
      },
      "surface-1": {
        "$type": "color",
        "$value": "#E8EEE4",
        "$description": "nested surface"
      },
      "border-hairline": {
        "$type": "color",
        "$value": "#D0DBC8",
        "$description": "divider"
      },
      "accent-hover": {
        "$type": "color",
        "$value": "#2F6F2C"
      },
      "accent-leaf": {
        "$type": "color",
        "$value": "#6BBF4A",
        "$description": "cox: accent-muted (solid soft accent)"
      },
      "chartreuse": {
        "$type": "color",
        "$value": "{brand.chartreuse}",
        "$description": "highlight / mark stroke"
      },
      "info": {
        "$type": "color",
        "$value": "#2F6B5A"
      },
      "code-bg": {
        "$type": "color",
        "$value": "{brand.forest}",
        "$description": "code / terminal"
      },
      "code-fg": {
        "$type": "color",
        "$value": "{brand.terminal-green}",
        "$description": "terminal text"
      },
      "glass-fill": {
        "$type": "string",
        "$value": "rgba(255, 255, 255, 0.72)"
      },
      "glass-border": {
        "$type": "string",
        "$value": "rgba(208, 219, 200, 0.9)"
      },
      "accent-glow": {
        "$type": "shadow",
        "$value": "0 0 0 3px var(--pyr-accent-muted), 0 0 18px rgba(61, 139, 58, 0.22)",
        "$description": "soft accent glow"
      }
    },
    "dark": {
      "bg": {
        "$type": "color",
        "$value": "#0A120E",
        "$description": "page background"
      },
      "surface": {
        "$type": "color",
        "$value": "{brand.forest}",
        "$description": "cards, panels (cox: bg-elevated)"
      },
      "surface-2": {
        "$type": "color",
        "$value": "#1E2A22",
        "$description": "hover / selected"
      },
      "surface-3": {
        "$type": "color",
        "$value": "#28362C",
        "$description": "pressed"
      },
      "border": {
        "$type": "color",
        "$value": "#344638",
        "$description": "default border"
      },
      "fg": {
        "$type": "color",
        "$value": "#E4EDE6",
        "$description": "primary text"
      },
      "fg-muted": {
        "$type": "color",
        "$value": "#8FA894",
        "$description": "secondary"
      },
      "fg-subtle": {
        "$type": "color",
        "$value": "#5A6E5E",
        "$description": "tertiary"
      },
      "accent": {
        "$type": "color",
        "$value": "{brand.chartreuse}",
        "$description": "primary CTA"
      },
      "accent-fg": {
        "$type": "color",
        "$value": "{brand.chartreuse}",
        "$description": "accent as text, >= 9.61:1"
      },
      "accent-muted": {
        "$type": "color",
        "$value": "#1A2A18",
        "$description": "accent wash (cox: accent-soft)"
      },
      "on-accent": {
        "$type": "color",
        "$value": "{brand.forest}",
        "$description": "text on an accent fill: forest ink, 11.50:1 on chartreuse"
      },
      "success": {
        "$type": "color",
        "$value": "#6BBF4A"
      },
      "success-fg": {
        "$type": "color",
        "$value": "#6BBF4A",
        "$description": ">= 6.51:1 on bg, surface, surface-2"
      },
      "warn": {
        "$type": "color",
        "$value": "#D4A84B",
        "$description": "cox: warning"
      },
      "warn-fg": {
        "$type": "color",
        "$value": "#D4A84B",
        "$description": ">= 6.74:1"
      },
      "danger": {
        "$type": "color",
        "$value": "#E07068"
      },
      "danger-fg": {
        "$type": "color",
        "$value": "#E07068",
        "$description": ">= 4.74:1"
      },
      "mark-tile": {
        "$type": "color",
        "$value": "{brand.forest}",
        "$description": "logo tile"
      },
      "shadow-e1": {
        "$type": "shadow",
        "$value": "0 1px 2px rgba(0, 0, 0, 0.35), 0 4px 16px rgba(0, 0, 0, 0.28)",
        "$description": "cox: shadow"
      },
      "surface-1": {
        "$type": "color",
        "$value": "#162018",
        "$description": "nested surface"
      },
      "border-hairline": {
        "$type": "color",
        "$value": "#1C2820",
        "$description": "divider"
      },
      "accent-hover": {
        "$type": "color",
        "$value": "{brand.terminal-green}"
      },
      "accent-leaf": {
        "$type": "color",
        "$value": "#6BBF4A",
        "$description": "cox: accent-muted (solid soft accent)"
      },
      "chartreuse": {
        "$type": "color",
        "$value": "{brand.terminal-green}",
        "$description": "highlight / mark stroke"
      },
      "info": {
        "$type": "color",
        "$value": "#5AABB0"
      },
      "code-bg": {
        "$type": "color",
        "$value": "#060A08",
        "$description": "code / terminal"
      },
      "code-fg": {
        "$type": "color",
        "$value": "{brand.terminal-green}",
        "$description": "terminal text"
      },
      "glass-fill": {
        "$type": "string",
        "$value": "rgba(15, 26, 20, 0.72)"
      },
      "glass-border": {
        "$type": "string",
        "$value": "rgba(28, 40, 32, 0.9)"
      },
      "accent-glow": {
        "$type": "shadow",
        "$value": "0 0 0 3px var(--pyr-accent-muted), 0 0 20px rgba(168, 224, 108, 0.28)",
        "$description": "soft accent glow"
      }
    }
  }
}
