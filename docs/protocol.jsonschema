{
  "event": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "title": "Event",
    "description": "Everything a consumer (TUI, `stream-json`, ACP, the rollout file) can\nobserve from a session (plan.md §1.2/§1.3). Every surface consumes the\nsame stream; nothing is emitted after `TurnDone` for that turn.",
    "oneOf": [
      {
        "description": "A new session began.",
        "type": "object",
        "properties": {
          "session": {
            "description": "The session's id.",
            "$ref": "#/$defs/SessionId"
          },
          "config_digest": {
            "description": "Hash of the effective config, for `resume_builds_identical_request`-style checks.",
            "type": "string"
          },
          "cwd": {
            "description": "The working directory the session started in.",
            "type": "string"
          },
          "type": {
            "type": "string",
            "const": "session_started"
          }
        },
        "required": [
          "type",
          "session",
          "config_digest",
          "cwd"
        ]
      },
      {
        "description": "A new turn began.",
        "type": "object",
        "properties": {
          "turn": {
            "description": "The turn's id.",
            "$ref": "#/$defs/TurnId"
          },
          "seq": {
            "description": "The turn's ordinal in this session, 1-based; `/rewind` names\nturns by it and the `checkpoints` rows carry it (T26.1).",
            "type": "integer",
            "format": "uint32",
            "minimum": 0,
            "default": 0
          },
          "job": {
            "description": "Which job this turn is (usually `Job::Main`).",
            "$ref": "#/$defs/Job"
          },
          "tier": {
            "description": "The tier routed to.",
            "$ref": "#/$defs/Tier"
          },
          "model": {
            "description": "The specific model used.",
            "$ref": "#/$defs/ModelId"
          },
          "type": {
            "type": "string",
            "const": "turn_started"
          }
        },
        "required": [
          "type",
          "turn",
          "job",
          "tier",
          "model"
        ]
      },
      {
        "description": "A new transcript item began accumulating.",
        "type": "object",
        "properties": {
          "item": {
            "description": "The item's id.",
            "$ref": "#/$defs/ItemId"
          },
          "kind": {
            "description": "What kind of item this is (may still be filling in text).",
            "$ref": "#/$defs/ItemKind"
          },
          "type": {
            "type": "string",
            "const": "item_started"
          }
        },
        "required": [
          "type",
          "item",
          "kind"
        ]
      },
      {
        "description": "Streamed text for an `AssistantMessage` item.",
        "type": "object",
        "properties": {
          "item": {
            "description": "The item this delta belongs to.",
            "$ref": "#/$defs/ItemId"
          },
          "text": {
            "description": "The next chunk of text.",
            "type": "string"
          },
          "type": {
            "type": "string",
            "const": "text_delta"
          }
        },
        "required": [
          "type",
          "item",
          "text"
        ]
      },
      {
        "description": "Streamed text for a `Thinking` item.",
        "type": "object",
        "properties": {
          "item": {
            "description": "The item this delta belongs to.",
            "$ref": "#/$defs/ItemId"
          },
          "text": {
            "description": "The next chunk of thinking text.",
            "type": "string"
          },
          "type": {
            "type": "string",
            "const": "thinking_delta"
          }
        },
        "required": [
          "type",
          "item",
          "text"
        ]
      },
      {
        "description": "A streamed `Thinking` item stopped growing (A91): how long the model\nthought, from its first to its last reasoning delta. Kept in the\nrollout, so a replay shows the duration the live run measured.",
        "type": "object",
        "properties": {
          "item": {
            "description": "The `Thinking` item that ended.",
            "$ref": "#/$defs/ItemId"
          },
          "duration_ms": {
            "description": "Milliseconds from the first to the last delta.",
            "type": "integer",
            "format": "uint64",
            "minimum": 0
          },
          "type": {
            "type": "string",
            "const": "thinking_done"
          }
        },
        "required": [
          "type",
          "item",
          "duration_ms"
        ]
      },
      {
        "description": "The model requested a tool call.",
        "type": "object",
        "properties": {
          "call": {
            "description": "The requested call.",
            "$ref": "#/$defs/ToolCall"
          },
          "type": {
            "type": "string",
            "const": "tool_call_requested"
          }
        },
        "required": [
          "type",
          "call"
        ]
      },
      {
        "description": "A tool call needs a decision before it can run.",
        "type": "object",
        "properties": {
          "call": {
            "description": "The call awaiting a decision.",
            "$ref": "#/$defs/ToolCall"
          },
          "why": {
            "description": "Why it needs one.",
            "$ref": "#/$defs/Why"
          },
          "source": {
            "description": "Who is asking (T27.2); `None` only on rollout lines written\nbefore the field existed.",
            "anyOf": [
              {
                "$ref": "#/$defs/Source"
              },
              {
                "type": "null"
              }
            ]
          },
          "type": {
            "type": "string",
            "const": "approval_required"
          }
        },
        "required": [
          "type",
          "call",
          "why"
        ]
      },
      {
        "description": "`ask_user` waits for the person (DT G4); a `Submission::Answer`\nwith the same `call_id` resumes it.",
        "type": "object",
        "properties": {
          "call_id": {
            "description": "The `ask_user` call asking.",
            "$ref": "#/$defs/CallId"
          },
          "question": {
            "description": "The question text.",
            "type": "string"
          },
          "options": {
            "description": "Suggested answers, possibly empty.",
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "source": {
            "description": "The subagent asking; `None` for the session the person talks to.",
            "anyOf": [
              {
                "$ref": "#/$defs/Source"
              },
              {
                "type": "null"
              }
            ]
          },
          "type": {
            "type": "string",
            "const": "question_asked"
          }
        },
        "required": [
          "type",
          "call_id",
          "question"
        ]
      },
      {
        "description": "A pending approval was decided.",
        "type": "object",
        "properties": {
          "call_id": {
            "description": "The call that was decided.",
            "$ref": "#/$defs/CallId"
          },
          "decision": {
            "description": "The decision.",
            "$ref": "#/$defs/Decision"
          },
          "by": {
            "description": "Who/what decided it.",
            "$ref": "#/$defs/DecidedBy"
          },
          "type": {
            "type": "string",
            "const": "approval_decided"
          }
        },
        "required": [
          "type",
          "call_id",
          "decision",
          "by"
        ]
      },
      {
        "description": "An `AllowForSession` grant was revoked (`Submission::RevokeGrant`).",
        "type": "object",
        "properties": {
          "tool": {
            "description": "The grant's tool.",
            "type": "string"
          },
          "subject": {
            "description": "The grant's subject prefix.",
            "type": "string"
          },
          "type": {
            "type": "string",
            "const": "grant_revoked"
          }
        },
        "required": [
          "type",
          "tool",
          "subject"
        ]
      },
      {
        "description": "Streamed stdout/stderr from a running tool, already sanitised for display.",
        "type": "object",
        "properties": {
          "call_id": {
            "description": "The call producing output.",
            "$ref": "#/$defs/CallId"
          },
          "delta": {
            "description": "The next chunk of output.",
            "type": "string"
          },
          "type": {
            "type": "string",
            "const": "tool_call_output"
          }
        },
        "required": [
          "type",
          "call_id",
          "delta"
        ]
      },
      {
        "description": "A tool call finished.",
        "type": "object",
        "properties": {
          "call_id": {
            "description": "The call that finished.",
            "$ref": "#/$defs/CallId"
          },
          "result": {
            "description": "Its result.",
            "$ref": "#/$defs/ToolResult"
          },
          "type": {
            "type": "string",
            "const": "tool_call_done"
          }
        },
        "required": [
          "type",
          "call_id",
          "result"
        ]
      },
      {
        "description": "A transcript item finished accumulating.",
        "type": "object",
        "properties": {
          "item": {
            "description": "The item that finished.",
            "$ref": "#/$defs/ItemId"
          },
          "type": {
            "type": "string",
            "const": "item_done"
          }
        },
        "required": [
          "type",
          "item"
        ]
      },
      {
        "description": "A provider call's usage/cost was recorded.",
        "type": "object",
        "properties": {
          "turn": {
            "description": "The turn this usage belongs to.",
            "$ref": "#/$defs/TurnId"
          },
          "usage": {
            "description": "The recorded usage.",
            "$ref": "#/$defs/Usage"
          },
          "type": {
            "type": "string",
            "const": "usage"
          }
        },
        "required": [
          "type",
          "turn",
          "usage"
        ]
      },
      {
        "description": "A request was assembled and is about to be sent (A98): the window\nand how the request fills it. Output only; the request is unchanged.",
        "type": "object",
        "properties": {
          "turn": {
            "description": "The turn the request belongs to.",
            "$ref": "#/$defs/TurnId"
          },
          "breakdown": {
            "description": "The window and the split.",
            "$ref": "#/$defs/ContextBreakdown"
          },
          "type": {
            "type": "string",
            "const": "context_breakdown"
          }
        },
        "required": [
          "type",
          "turn",
          "breakdown"
        ]
      },
      {
        "description": "Compaction ran and replaced older items with a summary.",
        "type": "object",
        "properties": {
          "summary": {
            "description": "The new summary item's id.",
            "$ref": "#/$defs/ItemId"
          },
          "dropped": {
            "description": "Items now skipped when building requests (rollout keeps them).",
            "type": "array",
            "items": {
              "$ref": "#/$defs/ItemId"
            }
          },
          "before_tokens": {
            "description": "Context tokens before compaction.",
            "type": "integer",
            "format": "uint32",
            "minimum": 0
          },
          "after_tokens": {
            "description": "Context tokens after compaction.",
            "type": "integer",
            "format": "uint32",
            "minimum": 0
          },
          "reason": {
            "description": "What triggered it (T28.3); rollouts written before the field\nexisted read as `post-turn`.",
            "$ref": "#/$defs/CompactReason",
            "default": "post-turn"
          },
          "type": {
            "type": "string",
            "const": "compacted"
          }
        },
        "required": [
          "type",
          "summary",
          "dropped",
          "before_tokens",
          "after_tokens"
        ]
      },
      {
        "description": "The repo map now in system[2] (P43). Its text is archived before\nthis is emitted; resume reads the last one back instead of\nrebuilding, so the replayed request carries the same bytes.",
        "type": "object",
        "properties": {
          "archive": {
            "description": "The archived map text.",
            "$ref": "#/$defs/ArchiveId"
          },
          "bytes": {
            "description": "Its size in bytes.",
            "type": "integer",
            "format": "uint64",
            "minimum": 0
          },
          "reason": {
            "description": "What built it.",
            "$ref": "#/$defs/RepoMapReason"
          },
          "type": {
            "type": "string",
            "const": "repo_map_built"
          }
        },
        "required": [
          "type",
          "archive",
          "bytes",
          "reason"
        ]
      },
      {
        "description": "Pre-images of the files a tool call changed are archived and\nretrievable (T26.1). Emitted after the `checkpoints` rows exist, so a\nsurface that sees it can already `/rewind`; never emitted for a call\nthat changed nothing.",
        "type": "object",
        "properties": {
          "turn": {
            "description": "The turn the call ran in.",
            "$ref": "#/$defs/TurnId"
          },
          "call": {
            "description": "The call, or `None` for a rewind's own writes.",
            "anyOf": [
              {
                "$ref": "#/$defs/CallId"
              },
              {
                "type": "null"
              }
            ]
          },
          "files": {
            "description": "Every path recorded, in path order.",
            "type": "array",
            "items": {
              "$ref": "#/$defs/CheckpointFile"
            }
          },
          "type": {
            "type": "string",
            "const": "checkpoint"
          }
        },
        "required": [
          "type",
          "turn",
          "files"
        ]
      },
      {
        "description": "`/rewind` finished (T26.2). With `conversation`, resume and the\ncontext builder stop reading history at `to_turn`; the rollout keeps\nevery earlier line.",
        "type": "object",
        "properties": {
          "to_turn": {
            "description": "The turn the session went back to.",
            "type": "integer",
            "format": "uint32",
            "minimum": 0
          },
          "code": {
            "description": "Files were restored.",
            "type": "boolean"
          },
          "conversation": {
            "description": "The conversation was cut.",
            "type": "boolean"
          },
          "restored": {
            "description": "Paths written back or removed.",
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "skipped": {
            "description": "Paths left as they are, each with why.",
            "type": "array",
            "items": {
              "$ref": "#/$defs/SkippedFile"
            }
          },
          "type": {
            "type": "string",
            "const": "rewound"
          }
        },
        "required": [
          "type",
          "to_turn",
          "code",
          "conversation",
          "restored",
          "skipped"
        ]
      },
      {
        "description": "A background task (subagent or detached `bash`) was created.",
        "type": "object",
        "properties": {
          "task": {
            "description": "The task's id.",
            "$ref": "#/$defs/TaskId"
          },
          "label": {
            "description": "A short human-readable label.",
            "type": "string"
          },
          "tier": {
            "description": "The tier it runs on.",
            "$ref": "#/$defs/Tier"
          },
          "type": {
            "type": "string",
            "const": "task_created"
          }
        },
        "required": [
          "type",
          "task",
          "label",
          "tier"
        ]
      },
      {
        "description": "A background task (subagent or detached `bash`) finished.",
        "type": "object",
        "properties": {
          "task": {
            "description": "The task that finished.",
            "$ref": "#/$defs/TaskId"
          },
          "result_item": {
            "description": "The item holding its result.",
            "$ref": "#/$defs/ItemId"
          },
          "cost_usd": {
            "description": "What it cost, in USD.",
            "type": "number",
            "format": "double"
          },
          "exit_code": {
            "description": "A shell task's exit code (T27.1); absent for subagents.",
            "type": [
              "integer",
              "null"
            ],
            "format": "int32"
          },
          "archive": {
            "description": "Where a shell task's full output was archived (T27.1).",
            "anyOf": [
              {
                "$ref": "#/$defs/ArchiveId"
              },
              {
                "type": "null"
              }
            ]
          },
          "type": {
            "type": "string",
            "const": "task_completed"
          }
        },
        "required": [
          "type",
          "task",
          "result_item",
          "cost_usd"
        ]
      },
      {
        "description": "A tier's model changed mid-session.",
        "type": "object",
        "properties": {
          "tier": {
            "description": "Which tier changed.",
            "$ref": "#/$defs/Tier"
          },
          "from": {
            "description": "The previous model.",
            "$ref": "#/$defs/ModelId"
          },
          "to": {
            "description": "The new model.",
            "$ref": "#/$defs/ModelId"
          },
          "type": {
            "type": "string",
            "const": "model_switched"
          }
        },
        "required": [
          "type",
          "tier",
          "from",
          "to"
        ]
      },
      {
        "description": "The session's permission mode or effort override changed\n(`SetPermissionMode`, `SetEffort`); carries both, as they now stand,\nso a surface sets its state from the event instead of echoing its\nown request (DT G5). Also recorded when a top-level session opens\n(T50.4), so resume and a woken subagent rebuild the mode the session\nlast ran under instead of falling back to `Default` (T50.2).",
        "type": "object",
        "properties": {
          "mode": {
            "description": "The permission mode now in force.",
            "$ref": "#/$defs/PermissionMode"
          },
          "effort": {
            "description": "The effort override; `None` means each tier's default.",
            "anyOf": [
              {
                "$ref": "#/$defs/Effort"
              },
              {
                "type": "null"
              }
            ]
          },
          "type": {
            "type": "string",
            "const": "state_changed"
          }
        },
        "required": [
          "type",
          "mode"
        ]
      },
      {
        "description": "The session's mode changed (`/mode`, P42), or a top-level session\nopened under a non-default one; carries the permission mode the\npreset left in force so a surface needs no second event.",
        "type": "object",
        "properties": {
          "mode": {
            "description": "The mode now in force.",
            "$ref": "#/$defs/Mode"
          },
          "permission_mode": {
            "description": "The permission mode now in force, after the preset narrowed it.",
            "$ref": "#/$defs/PermissionMode"
          },
          "type": {
            "type": "string",
            "const": "mode_changed"
          }
        },
        "required": [
          "type",
          "mode",
          "permission_mode"
        ]
      },
      {
        "description": "The session got a title (DT G6), for the sessions list and a window\nor tab title.",
        "type": "object",
        "properties": {
          "title": {
            "description": "The title, one line.",
            "type": "string"
          },
          "by_user": {
            "description": "Set by `Submission::Rename`: the store keeps it over any later\ngenerated title (A113). Absent in rollouts before T37.22.9.",
            "type": "boolean",
            "default": false
          },
          "type": {
            "type": "string",
            "const": "title_set"
          }
        },
        "required": [
          "type",
          "title"
        ]
      },
      {
        "description": "A decision plugin answered a decision point (PL§4, T33.20). Recorded\nfor every answer, used or not, so replay and `cox stats` see which\nadvice changed the core's pick; it never feeds model history.",
        "type": "object",
        "properties": {
          "point": {
            "description": "Which point asked.",
            "$ref": "#/$defs/DecidePoint"
          },
          "plugin": {
            "description": "The plugin `[plugins.decide]` names for the point.",
            "type": "string"
          },
          "advice": {
            "description": "The plugin's answer as given.",
            "$ref": "#/$defs/Advice"
          },
          "applied": {
            "description": "Whether the core followed it (its choice may equal the static\npick); `false` means it was ignored and the static pick stood.",
            "type": "boolean"
          },
          "type": {
            "type": "string",
            "const": "advised"
          }
        },
        "required": [
          "type",
          "point",
          "plugin",
          "advice",
          "applied"
        ]
      },
      {
        "description": "An informational or warning message, not part of the model-visible transcript.",
        "type": "object",
        "properties": {
          "level": {
            "description": "Severity.",
            "$ref": "#/$defs/Level"
          },
          "text": {
            "description": "The message.",
            "type": "string"
          },
          "type": {
            "type": "string",
            "const": "notice"
          }
        },
        "required": [
          "type",
          "level",
          "text"
        ]
      },
      {
        "description": "A turn finished.",
        "type": "object",
        "properties": {
          "turn": {
            "description": "The turn that finished.",
            "$ref": "#/$defs/TurnId"
          },
          "stop": {
            "description": "Why it stopped.",
            "$ref": "#/$defs/StopReason"
          },
          "type": {
            "type": "string",
            "const": "turn_done"
          }
        },
        "required": [
          "type",
          "turn",
          "stop"
        ]
      },
      {
        "description": "An error occurred.",
        "type": "object",
        "properties": {
          "error": {
            "description": "What went wrong.",
            "$ref": "#/$defs/CoreError"
          },
          "fatal": {
            "description": "Whether the whole session must end (`StoreError::Corrupt`, `Config`) or just the turn.",
            "type": "boolean"
          },
          "type": {
            "type": "string",
            "const": "error"
          }
        },
        "required": [
          "type",
          "error",
          "fatal"
        ]
      },
      {
        "description": "A follow-up for a background task was delivered or relayed (T34.4,\nSM§1); same fields as `Submission::TaskMessage`. Renders as one\ntranscript line labelled like a relayed approval (T34.7); ACP gives\nit its own arm instead of falling into `Ok(_) => {}` (T34.8).",
        "type": "object",
        "properties": {
          "task": {
            "description": "The task the message is addressed to.",
            "$ref": "#/$defs/TaskId"
          },
          "from": {
            "description": "Who it is from; `None` for the parent/user, `Some` for a sibling.",
            "anyOf": [
              {
                "$ref": "#/$defs/TaskId"
              },
              {
                "type": "null"
              }
            ]
          },
          "hop": {
            "description": "How many relays this message has been through (SM§5's loop guard).",
            "type": "integer",
            "format": "uint32",
            "minimum": 0
          },
          "text": {
            "description": "The message text.",
            "type": "string"
          },
          "type": {
            "type": "string",
            "const": "task_message"
          }
        },
        "required": [
          "type",
          "task",
          "hop",
          "text"
        ]
      }
    ],
    "$defs": {
      "SessionId": {
        "description": "SessionId: a 26-character Crockford-base32 ULID.",
        "type": "string",
        "pattern": "^[0-7][0-9A-HJKMNP-TV-Z]{25}$"
      },
      "TurnId": {
        "description": "TurnId: a 26-character Crockford-base32 ULID.",
        "type": "string",
        "pattern": "^[0-7][0-9A-HJKMNP-TV-Z]{25}$"
      },
      "Job": {
        "description": "What a request is *for* (plan.md §1.4); every job is pinned to one tier in config.",
        "oneOf": [
          {
            "description": "The main coding turn.",
            "type": "string",
            "const": "main"
          },
          {
            "description": "A `/think`/`--deep` plan.",
            "type": "string",
            "const": "plan"
          },
          {
            "description": "Compaction summary.",
            "type": "string",
            "const": "compact"
          },
          {
            "description": "Session title generation.",
            "type": "string",
            "const": "title"
          },
          {
            "description": "Tool-result or transcript summarisation.",
            "type": "string",
            "const": "summarize"
          },
          {
            "description": "Commit message generation.",
            "type": "string",
            "const": "commit"
          },
          {
            "description": "Memory extraction.",
            "type": "string",
            "const": "memory"
          },
          {
            "description": "An `explore` subagent.",
            "type": "string",
            "const": "explore"
          },
          {
            "description": "A background shell/HTTP subagent.",
            "type": "string",
            "const": "shell"
          },
          {
            "description": "A custom subagent definition (`.cox/agents`/`.claude/agents`,\nT34.1): its own `tier`/`model` decides the tier, not this job.",
            "type": "string",
            "const": "agent"
          },
          {
            "description": "A hook-driven LLM call.",
            "type": "string",
            "const": "hook"
          },
          {
            "description": "A plugin's own `cox_model_call` (PL§7d, T33.15): the router runs it\nat or below the plugin's granted tier, never `think`, and the\nledger row's job tag is `plugin:<id>`. No `[jobs]` entry names it —\nits tier comes from the call itself, already grant-clamped.",
            "type": "string",
            "pattern": "^plugin:.+$"
          }
        ]
      },
      "Tier": {
        "description": "A routing tier (plan.md §1.4/D5): a job maps to a tier, a tier maps to a model.\n\nOrdered cheapest first (declaration order), the one tier ordering every\n\"never up\" rule compares with: a plugin's model-call grant clamp\n(PL§7d) and the `route` decision point (PL§4, T33.20).",
        "oneOf": [
          {
            "description": "Haiku-class or local; mechanical work, never chosen for the main coding turn.",
            "type": "string",
            "const": "cheap"
          },
          {
            "description": "Sonnet by default, Opus when picked; the main coding turn.",
            "type": "string",
            "const": "code"
          },
          {
            "description": "Fable 5.1 only, only via `/think`/`--deep`, always confirmed.",
            "type": "string",
            "const": "think"
          }
        ]
      },
      "ModelId": {
        "description": "A newtype around a provider's model identifier (e.g. `\"claude-sonnet-5\"`).\nDeliberately a bare string, not an enum: models are configured, not\ncompiled in (`config/default.toml` [tiers.*].model).",
        "type": "string"
      },
      "ItemId": {
        "description": "ItemId: a 26-character Crockford-base32 ULID.",
        "type": "string",
        "pattern": "^[0-7][0-9A-HJKMNP-TV-Z]{25}$"
      },
      "ItemKind": {
        "description": "What kind of transcript item an `Item` is; each variant carries exactly\nwhat that item needs to be replayed into history on resume (plan.md\n§1.7: \"resume rebuilds `history` from `ItemStarted`/`ItemDone` pairs\").",
        "oneOf": [
          {
            "description": "The user's turn text plus any attachments.",
            "type": "object",
            "properties": {
              "text": {
                "description": "The submitted text.",
                "type": "string"
              },
              "attachments": {
                "description": "Attached files/images, if any.",
                "type": "array",
                "items": {
                  "$ref": "#/$defs/Attachment"
                }
              },
              "type": {
                "type": "string",
                "const": "user_message"
              }
            },
            "required": [
              "type",
              "text",
              "attachments"
            ]
          },
          {
            "description": "The assistant's visible reply text.",
            "type": "object",
            "properties": {
              "text": {
                "description": "The accumulated text (from `TextDelta`s).",
                "type": "string"
              },
              "type": {
                "type": "string",
                "const": "assistant_message"
              }
            },
            "required": [
              "type",
              "text"
            ]
          },
          {
            "description": "An extended-thinking block.",
            "type": "object",
            "properties": {
              "text": {
                "description": "The accumulated thinking text.",
                "type": "string"
              },
              "signature": {
                "description": "The provider's signature for replaying the block back, if it requires one.",
                "type": [
                  "string",
                  "null"
                ]
              },
              "type": {
                "type": "string",
                "const": "thinking"
              }
            },
            "required": [
              "type",
              "text"
            ]
          },
          {
            "description": "A tool call the model requested.",
            "type": "object",
            "properties": {
              "call": {
                "description": "The call itself.",
                "$ref": "#/$defs/ToolCall"
              },
              "type": {
                "type": "string",
                "const": "tool_call"
              }
            },
            "required": [
              "type",
              "call"
            ]
          },
          {
            "description": "A finished tool call's result.",
            "type": "object",
            "properties": {
              "call_id": {
                "description": "The call this result belongs to.",
                "$ref": "#/$defs/CallId"
              },
              "result": {
                "description": "The result.",
                "$ref": "#/$defs/ToolResult"
              },
              "type": {
                "type": "string",
                "const": "tool_result"
              }
            },
            "required": [
              "type",
              "call_id",
              "result"
            ]
          },
          {
            "description": "A compaction summary.",
            "type": "object",
            "properties": {
              "text": {
                "description": "The summary text.",
                "type": "string"
              },
              "type": {
                "type": "string",
                "const": "summary"
              }
            },
            "required": [
              "type",
              "text"
            ]
          },
          {
            "description": "A cox-generated notice (not part of the model-visible transcript).",
            "type": "object",
            "properties": {
              "level": {
                "description": "The notice's severity.",
                "$ref": "#/$defs/Level"
              },
              "text": {
                "description": "The notice text.",
                "type": "string"
              },
              "type": {
                "type": "string",
                "const": "notice"
              }
            },
            "required": [
              "type",
              "level",
              "text"
            ]
          }
        ]
      },
      "Attachment": {
        "description": "A file, image or other blob attached to a `UserTurn`.",
        "type": "object",
        "properties": {
          "name": {
            "description": "Display name (usually the original filename).",
            "type": "string"
          },
          "media_type": {
            "description": "MIME type, e.g. `\"image/png\"`.",
            "type": "string"
          },
          "data_b64": {
            "description": "Base64-encoded bytes.",
            "type": "string"
          }
        },
        "required": [
          "name",
          "media_type",
          "data_b64"
        ]
      },
      "ToolCall": {
        "description": "A request from the model to run a tool.",
        "type": "object",
        "properties": {
          "id": {
            "description": "Correlates `ToolCallRequested` through `ToolCallDone`.",
            "$ref": "#/$defs/CallId"
          },
          "name": {
            "description": "The tool's registered name (or `mcp__<server>__<tool>`).",
            "type": "string"
          },
          "input": {
            "description": "The model-supplied arguments, validated against the tool's `input_schema`."
          },
          "risk": {
            "description": "The call's risk classification, used by the permission engine.",
            "$ref": "#/$defs/Risk"
          },
          "subject": {
            "description": "What permission rules match on: the confined path, command line, URL, or MCP name.",
            "type": "string"
          },
          "segments": {
            "description": "The simple commands a shell `subject` splits into (T36.1). `None`\nmeans the subject is one unit, as for every tool that is not a shell.",
            "anyOf": [
              {
                "$ref": "#/$defs/Segments"
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "required": [
          "id",
          "name",
          "input",
          "risk",
          "subject"
        ]
      },
      "CallId": {
        "description": "CallId: a 26-character Crockford-base32 ULID.",
        "type": "string",
        "pattern": "^[0-7][0-9A-HJKMNP-TV-Z]{25}$"
      },
      "Risk": {
        "description": "How risky a tool call is, independent of what it does (plan.md §1.8).",
        "oneOf": [
          {
            "description": "Cannot change anything cox does not already show the model.",
            "type": "string",
            "const": "read_only"
          },
          {
            "description": "Writes inside the workspace.",
            "type": "string",
            "const": "write"
          },
          {
            "description": "Runs a process.",
            "type": "string",
            "const": "exec"
          },
          {
            "description": "Can destroy data or affect more than the immediate subject (`rm -rf`, `apply_patch` deleting > 5 files).",
            "type": "string",
            "const": "destructive"
          }
        ]
      },
      "Segments": {
        "description": "A compound command line as the permission engine judges it (T36.1): a\ndeny or ask rule matching any command denies or asks, an allow rule or a\nsession grant must cover every command. Plain strings, so the engine\nstays pure and the shell tool owns the parser.",
        "type": "object",
        "properties": {
          "commands": {
            "description": "Every simple command in source order, including those nested in a\nsubshell, a substitution or a loop body.",
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "opaque": {
            "description": "The split cannot vouch for the whole line — a substitution, `eval`,\n`sh -c`, a variable assignment, an output redirect to a path, or a\nparse error — so no prefix rule or grant may allow it; deny and ask\nrules still match `commands`.",
            "type": "boolean"
          }
        },
        "required": [
          "commands"
        ]
      },
      "ToolResult": {
        "description": "The outcome of a finished tool call, as it appears in history.",
        "type": "object",
        "properties": {
          "ok": {
            "description": "Whether the call succeeded.",
            "type": "boolean"
          },
          "visible": {
            "description": "What the model sees: possibly truncated, with a pointer trailer.",
            "type": "string"
          },
          "archive": {
            "description": "Where the untruncated output lives, if it was archived.",
            "anyOf": [
              {
                "$ref": "#/$defs/ArchiveRef"
              },
              {
                "type": "null"
              }
            ]
          },
          "bytes": {
            "description": "Size of the full (pre-truncation) output, in bytes.",
            "type": "integer",
            "format": "uint64",
            "minimum": 0
          },
          "duration_ms": {
            "description": "Wall-clock time the call took.",
            "type": "integer",
            "format": "uint64",
            "minimum": 0
          },
          "diff": {
            "description": "A unified diff, for edit-shaped tools.",
            "anyOf": [
              {
                "$ref": "#/$defs/Diff"
              },
              {
                "type": "null"
              }
            ]
          },
          "structured": {
            "description": "The tool's machine-readable payload (`ToolOutput.structured`), so a\nsurface reads data instead of re-parsing `visible` (DT G3). Absent\nfrom rollouts written before it existed. Boxed: it is rare, and every\n`Event::ToolCallDone` would otherwise carry its full width."
          }
        },
        "required": [
          "ok",
          "visible",
          "bytes",
          "duration_ms"
        ]
      },
      "ArchiveRef": {
        "description": "A pointer to a full tool output stored in the archive (plan.md §1.7/D6a).",
        "type": "object",
        "properties": {
          "id": {
            "description": "The archive row's id (`cox expand <id>`).",
            "$ref": "#/$defs/ArchiveId"
          },
          "bytes": {
            "description": "Size of the archived payload, in bytes.",
            "type": "integer",
            "format": "uint64",
            "minimum": 0
          }
        },
        "required": [
          "id",
          "bytes"
        ]
      },
      "ArchiveId": {
        "description": "ArchiveId: a 26-character Crockford-base32 ULID.",
        "type": "string",
        "pattern": "^[0-7][0-9A-HJKMNP-TV-Z]{25}$"
      },
      "Diff": {
        "description": "A unified diff for one file, produced by `edit`/`apply_patch`/`write`.",
        "type": "object",
        "properties": {
          "path": {
            "description": "The file the diff applies to.",
            "type": "string"
          },
          "unified": {
            "description": "Unified diff text (`---`/`+++`/`@@` form).",
            "type": "string"
          }
        },
        "required": [
          "path",
          "unified"
        ]
      },
      "Level": {
        "description": "Severity of a `Notice` event.",
        "oneOf": [
          {
            "description": "Informational; no action needed.",
            "type": "string",
            "const": "info"
          },
          {
            "description": "Something degraded but the turn continued (e.g. a skipped hook).",
            "type": "string",
            "const": "warn"
          },
          {
            "description": "A budget threshold was crossed.",
            "type": "string",
            "const": "budget"
          },
          {
            "description": "A trust-boundary guard fired (sanitized output, sandbox denial).",
            "type": "string",
            "const": "security"
          }
        ]
      },
      "Why": {
        "description": "Why an `ApprovalRequired` was raised (plan.md §1.2/§1.8 step 9).",
        "oneOf": [
          {
            "description": "An `ask` rule matched.",
            "type": "object",
            "properties": {
              "rule": {
                "description": "The rule string that matched (e.g. `\"Bash(git commit:*)\"`).",
                "type": "string"
              },
              "type": {
                "type": "string",
                "const": "rule_ask"
              }
            },
            "required": [
              "type",
              "rule"
            ]
          },
          {
            "description": "No rule matched; the call's risk classification requires asking.",
            "type": "object",
            "properties": {
              "risk": {
                "description": "The call's risk.",
                "$ref": "#/$defs/Risk"
              },
              "type": {
                "type": "string",
                "const": "risk"
              }
            },
            "required": [
              "type",
              "risk"
            ]
          },
          {
            "description": "The sandbox denied the call and `approval == on-failure`.",
            "type": "object",
            "properties": {
              "detail": {
                "description": "The sandbox backend's denial detail.",
                "type": "string"
              },
              "type": {
                "type": "string",
                "const": "sandbox_denied"
              }
            },
            "required": [
              "type",
              "detail"
            ]
          },
          {
            "description": "The active approval policy forces asking regardless of risk.",
            "type": "object",
            "properties": {
              "policy": {
                "description": "The policy in effect.",
                "$ref": "#/$defs/ApprovalPolicy"
              },
              "type": {
                "type": "string",
                "const": "policy"
              }
            },
            "required": [
              "type",
              "policy"
            ]
          }
        ]
      },
      "ApprovalPolicy": {
        "description": "`permissions.approval` (plan.md §1.6/§1.8 step 8).",
        "oneOf": [
          {
            "description": "Anything not covered by an `allow` rule asks.",
            "type": "string",
            "const": "untrusted"
          },
          {
            "description": "Default: risk-based asking (step 7).",
            "type": "string",
            "const": "on-request"
          },
          {
            "description": "`Exec` runs sandboxed without asking; asks only if the sandbox denies.",
            "type": "string",
            "const": "on-failure"
          },
          {
            "description": "Any `Ask` becomes `Deny` (headless default).",
            "type": "string",
            "const": "never"
          }
        ]
      },
      "Source": {
        "description": "The session an approval comes from (T27.2). A subagent's is relayed to\nits parent's surface, so the prompt names the agent that is asking.",
        "type": "object",
        "properties": {
          "session": {
            "description": "The session whose call waits.",
            "$ref": "#/$defs/SessionId"
          },
          "agent": {
            "description": "The subagent's name (`explore-2`); `None` for the session the user\nis talking to.",
            "type": [
              "string",
              "null"
            ]
          },
          "preset": {
            "description": "The subagent's preset (`explore`, `shell`).",
            "type": [
              "string",
              "null"
            ]
          }
        },
        "required": [
          "session"
        ]
      },
      "Decision": {
        "description": "An approval decision, for both `Submission::Approve` and `ApprovalDecided`.",
        "oneOf": [
          {
            "description": "Run the call once.",
            "type": "object",
            "properties": {
              "type": {
                "type": "string",
                "const": "allow"
              }
            },
            "required": [
              "type"
            ]
          },
          {
            "description": "Run this call and grant future calls with the same tool + subject prefix, for this session.",
            "type": "object",
            "properties": {
              "type": {
                "type": "string",
                "const": "allow_for_session"
              }
            },
            "required": [
              "type"
            ]
          },
          {
            "description": "Refuse the call.",
            "type": "object",
            "properties": {
              "reason": {
                "description": "Shown to the model as the tool result.",
                "type": "string"
              },
              "type": {
                "type": "string",
                "const": "deny"
              }
            },
            "required": [
              "type",
              "reason"
            ]
          },
          {
            "description": "Run the call, but with edited input (e.g. a corrected path).",
            "type": "object",
            "properties": {
              "input": {
                "description": "The replacement input."
              },
              "type": {
                "type": "string",
                "const": "edit"
              }
            },
            "required": [
              "type",
              "input"
            ]
          }
        ]
      },
      "DecidedBy": {
        "description": "Who decided an approval (`ApprovalDecided::by`).",
        "oneOf": [
          {
            "description": "The user answered an `ApprovalRequired` prompt.",
            "type": "string",
            "const": "user"
          },
          {
            "description": "An `allow`/`deny`/`ask` rule matched.",
            "type": "string",
            "const": "rule"
          },
          {
            "description": "An `AllowForSession` grant from earlier in the session matched.",
            "type": "string",
            "const": "session"
          },
          {
            "description": "The permission mode or approval policy decided without a rule.",
            "type": "string",
            "const": "policy"
          },
          {
            "description": "A `PreToolUse` hook decided (`Block`/`Modify`).",
            "type": "string",
            "const": "hook"
          }
        ]
      },
      "Usage": {
        "description": "Per-request token/cost accounting (plan.md §1.2/§1.9); one row per provider call.",
        "type": "object",
        "properties": {
          "input_tokens": {
            "description": "Input tokens billed at the full rate.",
            "type": "integer",
            "format": "uint32",
            "minimum": 0
          },
          "output_tokens": {
            "description": "Output tokens generated.",
            "type": "integer",
            "format": "uint32",
            "minimum": 0
          },
          "cache_read_tokens": {
            "description": "Input tokens served from cache (billed at the cache-read rate).",
            "type": "integer",
            "format": "uint32",
            "minimum": 0
          },
          "cache_write_tokens": {
            "description": "Input tokens written to cache (billed at the cache-write rate).",
            "type": "integer",
            "format": "uint32",
            "minimum": 0
          },
          "estimated": {
            "description": "True when the provider reported no usage and cox estimated it.",
            "type": "boolean"
          },
          "cost_usd": {
            "description": "Computed cost of this call, in USD.",
            "type": "number",
            "format": "double"
          },
          "latency_ms": {
            "description": "Wall-clock latency of this call.",
            "type": "integer",
            "format": "uint64",
            "minimum": 0
          }
        },
        "required": [
          "input_tokens",
          "output_tokens",
          "cache_read_tokens",
          "cache_write_tokens",
          "estimated",
          "cost_usd",
          "latency_ms"
        ]
      },
      "ContextBreakdown": {
        "description": "Where the context of the request about to be sent goes (A98): the\nmodel's window and the request's estimated tokens split into the four\nparts both surfaces draw. Emitted before the reply, so it cannot ride on\n`Usage`, which only exists after it.",
        "type": "object",
        "properties": {
          "window": {
            "description": "The model's context window in tokens; `None` when neither the model\ncatalog nor the provider knows it.",
            "type": [
              "integer",
              "null"
            ],
            "format": "uint32",
            "minimum": 0
          },
          "total": {
            "description": "The request's estimated tokens; the four parts sum to it exactly.",
            "type": "integer",
            "format": "uint32",
            "minimum": 0
          },
          "system": {
            "description": "The system prompt and the volatile environment block.",
            "type": "integer",
            "format": "uint32",
            "minimum": 0
          },
          "tools": {
            "description": "The tool schemas.",
            "type": "integer",
            "format": "uint32",
            "minimum": 0
          },
          "instructions": {
            "description": "Instruction files and the skills index.",
            "type": "integer",
            "format": "uint32",
            "minimum": 0
          },
          "history": {
            "description": "The conversation: verbatim turns, archive pointers and summaries.",
            "type": "integer",
            "format": "uint32",
            "minimum": 0
          },
          "cached": {
            "description": "Tokens the last call served from cache, as its usage reported.",
            "type": "integer",
            "format": "uint32",
            "minimum": 0
          }
        },
        "required": [
          "total",
          "system",
          "tools",
          "instructions",
          "history",
          "cached"
        ]
      },
      "CompactReason": {
        "description": "Why `Event::Compacted` happened (plan.md §1.10, T28.3).",
        "oneOf": [
          {
            "description": "Inside a turn, before a provider call whose request would exceed\n`compact_at × max_context`.",
            "type": "string",
            "const": "pre-call"
          },
          {
            "description": "At the next turn's start, from the last call's reported usage.",
            "type": "string",
            "const": "post-turn"
          },
          {
            "description": "`/compact` or `Submission::Compact`.",
            "type": "string",
            "const": "manual"
          },
          {
            "description": "The provider rejected a request as too long; the call retries once.",
            "type": "string",
            "const": "context-too-long"
          }
        ]
      },
      "RepoMapReason": {
        "description": "Why `Event::RepoMapBuilt` happened (P43): the only three moments the\nrepo map in system[2] is built.",
        "oneOf": [
          {
            "description": "Before the first request of a session.",
            "type": "string",
            "const": "session_start"
          },
          {
            "description": "`/repomap refresh` produced different bytes.",
            "type": "string",
            "const": "refresh"
          },
          {
            "description": "Compaction rebuilt it with the prefix it already restarts.",
            "type": "string",
            "const": "compaction"
          }
        ]
      },
      "CheckpointFile": {
        "description": "One path in an `Event::Checkpoint`.",
        "type": "object",
        "properties": {
          "path": {
            "description": "The confined absolute path.",
            "type": "string"
          },
          "kind": {
            "description": "What was recorded for it.",
            "$ref": "#/$defs/CheckpointKind"
          }
        },
        "required": [
          "path",
          "kind"
        ]
      },
      "CheckpointKind": {
        "description": "What a `checkpoints` row holds for one path (T26.1): the bytes a tool\ncall was about to overwrite, a file it created, a file it deleted, or\nthe marker that starts a user turn (`path` empty).",
        "oneOf": [
          {
            "description": "The pre-image of a file that was changed; `archive` holds its bytes.",
            "type": "string",
            "const": "pre"
          },
          {
            "description": "The file did not exist before the call.",
            "type": "string",
            "const": "created"
          },
          {
            "description": "The file existed before the call and is gone after it; `archive` holds it.",
            "type": "string",
            "const": "deleted"
          },
          {
            "description": "A user turn started; nothing archived.",
            "type": "string",
            "const": "turn"
          }
        ]
      },
      "SkippedFile": {
        "description": "A file a code rewind left as it is (`Event::Rewound`), and why (A101).",
        "type": "object",
        "properties": {
          "path": {
            "description": "The confined absolute path.",
            "type": "string"
          },
          "reason": {
            "description": "Why it was not restored.",
            "$ref": "#/$defs/SkipReason"
          }
        },
        "required": [
          "path",
          "reason"
        ]
      },
      "SkipReason": {
        "description": "Why a rewind could not restore a file.",
        "oneOf": [
          {
            "description": "Its pre-image was over the size cap, so no bytes were kept.",
            "type": "object",
            "properties": {
              "kind": {
                "type": "string",
                "const": "too_large"
              }
            },
            "required": [
              "kind"
            ]
          },
          {
            "description": "The path no longer confines to the workspace roots.",
            "type": "object",
            "properties": {
              "kind": {
                "type": "string",
                "const": "outside_roots"
              }
            },
            "required": [
              "kind"
            ]
          },
          {
            "description": "Reading the pre-image or writing the file failed.",
            "type": "object",
            "properties": {
              "error": {
                "description": "The error, as shown to the user.",
                "type": "string"
              },
              "kind": {
                "type": "string",
                "const": "failed"
              }
            },
            "required": [
              "kind",
              "error"
            ]
          }
        ]
      },
      "TaskId": {
        "description": "TaskId: a 26-character Crockford-base32 ULID.",
        "type": "string",
        "pattern": "^[0-7][0-9A-HJKMNP-TV-Z]{25}$"
      },
      "PermissionMode": {
        "description": "`permissions.mode` (plan.md §1.6/§1.8).",
        "oneOf": [
          {
            "description": "Rules and risk decide as usual.",
            "type": "string",
            "const": "default"
          },
          {
            "description": "Only `Risk::ReadOnly` is allowed; everything else denies without asking.",
            "type": "string",
            "const": "plan"
          },
          {
            "description": "`Write` is allowed automatically; `Exec`/`Destructive` still ask unless a safe-command match.",
            "type": "string",
            "const": "auto"
          },
          {
            "description": "Everything is allowed; flag-only, banner shown.",
            "type": "string",
            "const": "bypass"
          }
        ]
      },
      "Effort": {
        "description": "Reasoning effort passed to the provider.\n\nOrdered `Low < Medium < High < Xhigh` so the router can clamp a tier's\neffort to the greatest level a model supports (`docs/design/providers.md`).\nThe four levels are models.dev's own, so a catalog row maps without loss\n(T30.26).",
        "oneOf": [
          {
            "description": "Cheapest, fastest; used for `cheap`-tier jobs.",
            "type": "string",
            "const": "low"
          },
          {
            "description": "Between `Low` and `High`: models.dev's and the wires' `medium`.",
            "type": "string",
            "const": "medium"
          },
          {
            "description": "Default for `code`/`think` tiers.",
            "type": "string",
            "const": "high"
          },
          {
            "description": "User-selected for a flagged large refactor.",
            "type": "string",
            "const": "xhigh"
          }
        ]
      },
      "Mode": {
        "description": "`core.mode` / `--mode` / `/mode` (P42, A73): a named preset over the\npermission mode and the main tier only. It never filters tools, so the\ncache prefix stays byte-stable, and it only narrows `permissions.mode`.",
        "oneOf": [
          {
            "description": "The configured permission mode and main tier, unchanged.",
            "type": "string",
            "const": "editor"
          },
          {
            "description": "`Plan` (read-only tools only) and the `think` main tier, confirmed.",
            "type": "string",
            "const": "architect"
          }
        ]
      },
      "DecidePoint": {
        "description": "A decision point (PL§4 \"Decision points\").",
        "oneOf": [
          {
            "description": "Tier for a user turn; only down.",
            "type": "string",
            "const": "route"
          },
          {
            "description": "Severity of a tool call; only up.",
            "type": "string",
            "const": "risk"
          },
          {
            "description": "A caution note on the approval modal; never \"looks safe\".",
            "type": "string",
            "const": "approve_hint"
          },
          {
            "description": "Compact now; only earlier.",
            "type": "string",
            "const": "compact"
          },
          {
            "description": "Reorder or filter candidates; never add.",
            "type": "string",
            "const": "rank"
          },
          {
            "description": "Salience of a memory item.",
            "type": "string",
            "const": "salience"
          }
        ]
      },
      "Advice": {
        "description": "`cox_decide` output. The core applies the point's monotone rule and\nuses its local default when confidence is below `min_confidence`.",
        "type": "object",
        "properties": {
          "answer": {
            "description": "The answer.",
            "$ref": "#/$defs/Answer"
          },
          "confidence": {
            "description": "In `[0, 1]`; absent when the model gives none (a yes/no, J11).",
            "type": [
              "number",
              "null"
            ],
            "format": "double",
            "default": null
          },
          "note": {
            "description": "A caution note, for `approve_hint`.",
            "type": [
              "string",
              "null"
            ],
            "default": null
          }
        },
        "required": [
          "answer"
        ]
      },
      "Answer": {
        "description": "The three question kinds a decision model answers.",
        "oneOf": [
          {
            "description": "Indices into `Question.options`, best first.",
            "type": "object",
            "properties": {
              "order": {
                "description": "The ranking.",
                "type": "array",
                "items": {
                  "type": "integer",
                  "format": "uint32",
                  "minimum": 0
                }
              },
              "kind": {
                "type": "string",
                "const": "choice"
              }
            },
            "required": [
              "kind",
              "order"
            ]
          },
          {
            "description": "A score on the point's scale.",
            "type": "object",
            "properties": {
              "value": {
                "description": "The score.",
                "type": "number",
                "format": "double"
              },
              "kind": {
                "type": "string",
                "const": "score"
              }
            },
            "required": [
              "kind",
              "value"
            ]
          },
          {
            "description": "A yes/no probability.",
            "type": "object",
            "properties": {
              "p_yes": {
                "description": "P(yes) in `[0, 1]`.",
                "type": "number",
                "format": "double"
              },
              "kind": {
                "type": "string",
                "const": "noul"
              }
            },
            "required": [
              "kind",
              "p_yes"
            ]
          },
          {
            "description": "One score per item of a batched question (`salience`, T33.21.1):\n`Question` has no `items` field yet (that is T33.40.1's batched-ABI\ncard), so the items travel in `Question.state[\"items\"]` and the\nanswer carries one value per item, aligned by index.",
            "type": "object",
            "properties": {
              "values": {
                "description": "One score per item, same length and order as the items sent.",
                "type": "array",
                "items": {
                  "type": "number",
                  "format": "double"
                }
              },
              "kind": {
                "type": "string",
                "const": "scores"
              }
            },
            "required": [
              "kind",
              "values"
            ]
          }
        ]
      },
      "StopReason": {
        "description": "Why a provider call or a turn stopped.\n\nReused for both `ProviderEvent::Stop` (one provider call) and\n`Event::TurnDone` (the whole turn); a provider only ever emits\n`EndTurn`/`Refusal`/`Error`, the others are added by `cox-core` once it\nhas aggregated multiple calls in a turn.",
        "oneOf": [
          {
            "description": "The model finished normally.",
            "type": "object",
            "properties": {
              "type": {
                "type": "string",
                "const": "end_turn"
              }
            },
            "required": [
              "type"
            ]
          },
          {
            "description": "`core.max_turns` provider calls were used up without finishing.",
            "type": "object",
            "properties": {
              "type": {
                "type": "string",
                "const": "max_turns"
              }
            },
            "required": [
              "type"
            ]
          },
          {
            "description": "`Submission::Interrupt` cancelled the turn.",
            "type": "object",
            "properties": {
              "type": {
                "type": "string",
                "const": "interrupted"
              }
            },
            "required": [
              "type"
            ]
          },
          {
            "description": "A budget cap stopped the turn before another call was made.",
            "type": "object",
            "properties": {
              "type": {
                "type": "string",
                "const": "budget"
              }
            },
            "required": [
              "type"
            ]
          },
          {
            "description": "The model refused to continue.",
            "type": "object",
            "properties": {
              "detail": {
                "description": "The provider's refusal text, if any.",
                "type": "string"
              },
              "type": {
                "type": "string",
                "const": "refusal"
              }
            },
            "required": [
              "type",
              "detail"
            ]
          },
          {
            "description": "The turn ended in an unrecoverable error.",
            "type": "object",
            "properties": {
              "type": {
                "type": "string",
                "const": "error"
              }
            },
            "required": [
              "type"
            ]
          }
        ]
      },
      "CoreError": {
        "description": "Failures from `cox-core`'s turn loop.",
        "oneOf": [
          {
            "description": "The session or monthly budget cap was hit.",
            "type": "object",
            "properties": {
              "spent": {
                "description": "Amount spent so far, in USD.",
                "type": "number",
                "format": "double"
              },
              "cap": {
                "description": "The configured cap, in USD.",
                "type": "number",
                "format": "double"
              },
              "type": {
                "type": "string",
                "const": "budget"
              }
            },
            "required": [
              "type",
              "spent",
              "cap"
            ]
          },
          {
            "description": "The turn was cancelled via `Submission::Interrupt`.",
            "type": "object",
            "properties": {
              "type": {
                "type": "string",
                "const": "interrupted"
              }
            },
            "required": [
              "type"
            ]
          },
          {
            "description": "The provider call failed.",
            "type": "object",
            "properties": {
              "error": {
                "description": "The underlying provider failure.",
                "$ref": "#/$defs/ProviderError"
              },
              "type": {
                "type": "string",
                "const": "provider"
              }
            },
            "required": [
              "type",
              "error"
            ]
          },
          {
            "description": "A tool call failed.",
            "type": "object",
            "properties": {
              "call": {
                "description": "The call that failed.",
                "$ref": "#/$defs/CallId"
              },
              "error": {
                "description": "The underlying tool failure.",
                "$ref": "#/$defs/ToolError"
              },
              "type": {
                "type": "string",
                "const": "tool"
              }
            },
            "required": [
              "type",
              "call",
              "error"
            ]
          },
          {
            "description": "Compaction failed to produce a summary.",
            "type": "object",
            "properties": {
              "type": {
                "type": "string",
                "const": "compaction"
              }
            },
            "required": [
              "type"
            ]
          },
          {
            "description": "A config value was invalid or out of range.",
            "type": "object",
            "properties": {
              "key": {
                "description": "The dotted config key.",
                "type": "string"
              },
              "message": {
                "description": "Why the value was rejected.",
                "type": "string"
              },
              "type": {
                "type": "string",
                "const": "config"
              }
            },
            "required": [
              "type",
              "key",
              "message"
            ]
          },
          {
            "description": "The store failed (fatal to the session, per plan.md §1.14).",
            "type": "object",
            "properties": {
              "error": {
                "description": "The underlying store failure.",
                "$ref": "#/$defs/StoreError"
              },
              "type": {
                "type": "string",
                "const": "store"
              }
            },
            "required": [
              "type",
              "error"
            ]
          },
          {
            "description": "A hook failed in a way that was not fail-open (rare; hooks usually just warn).",
            "type": "object",
            "properties": {
              "id": {
                "description": "The hook's configured id.",
                "type": "string"
              },
              "error": {
                "description": "The hook's error text.",
                "type": "string"
              },
              "type": {
                "type": "string",
                "const": "hook"
              }
            },
            "required": [
              "type",
              "id",
              "error"
            ]
          },
          {
            "description": "A subagent action was refused by a named guard — T34.2's\nconcurrency cap or T34.6's message-flood cap — shaped like\n`ToolError::Denied` so `Relay::send_message` can hand the same text\nback to whoever called it.",
            "type": "object",
            "properties": {
              "why": {
                "description": "Human-readable reason.",
                "type": "string"
              },
              "type": {
                "type": "string",
                "const": "denied"
              }
            },
            "required": [
              "type",
              "why"
            ]
          },
          {
            "description": "An external agent process (EA§5, e.g. a plugin-driven CLI like\nCursor's) reported its own run as failed. Distinct from `Provider`\n(A58): the external agent stands in for a whole child session, not\ncox's own model call, so its failure must never be classified or\nretried as one — `cox-provider-http::retry::retryable` only ever\ntakes a `ProviderError`, which this variant never becomes.",
            "type": "object",
            "properties": {
              "agent": {
                "description": "The external agent's name (its plugin/preset id).",
                "type": "string"
              },
              "message": {
                "description": "The agent's own error text, already sanitized by the caller.",
                "type": "string"
              },
              "type": {
                "type": "string",
                "const": "external_agent"
              }
            },
            "required": [
              "type",
              "agent",
              "message"
            ]
          }
        ]
      },
      "ProviderError": {
        "description": "Failures from a `Provider` implementation (`cox-provider`).",
        "oneOf": [
          {
            "description": "The provider rejected the request's credentials.",
            "type": "object",
            "properties": {
              "type": {
                "type": "string",
                "const": "auth"
              }
            },
            "required": [
              "type"
            ]
          },
          {
            "description": "The provider is rate-limiting this key.",
            "type": "object",
            "properties": {
              "retry_after": {
                "description": "Seconds to wait before retrying, from the provider's `retry-after`, if given.",
                "type": [
                  "integer",
                  "null"
                ],
                "format": "uint64",
                "minimum": 0
              },
              "type": {
                "type": "string",
                "const": "rate_limited"
              }
            },
            "required": [
              "type"
            ]
          },
          {
            "description": "The provider is temporarily overloaded (5xx, no retry-after).",
            "type": "object",
            "properties": {
              "type": {
                "type": "string",
                "const": "overloaded"
              }
            },
            "required": [
              "type"
            ]
          },
          {
            "description": "The provider rejected the request shape itself (4xx, not auth).",
            "type": "object",
            "properties": {
              "message": {
                "description": "The provider's error message, verbatim.",
                "type": "string"
              },
              "type": {
                "type": "string",
                "const": "bad_request"
              }
            },
            "required": [
              "type",
              "message"
            ]
          },
          {
            "description": "The assembled request exceeds the model's context window.",
            "type": "object",
            "properties": {
              "max": {
                "description": "The model's max context, in tokens.",
                "type": "integer",
                "format": "uint32",
                "minimum": 0
              },
              "got": {
                "description": "The estimated size of the request that was rejected.",
                "type": "integer",
                "format": "uint32",
                "minimum": 0
              },
              "type": {
                "type": "string",
                "const": "context_too_long"
              }
            },
            "required": [
              "type",
              "max",
              "got"
            ]
          },
          {
            "description": "The model declined to continue (content policy, not an error).",
            "type": "object",
            "properties": {
              "detail": {
                "description": "The provider's refusal text, if any.",
                "type": "string"
              },
              "type": {
                "type": "string",
                "const": "refusal"
              }
            },
            "required": [
              "type",
              "detail"
            ]
          },
          {
            "description": "A transport-level failure (DNS, TLS, connection reset).",
            "type": "object",
            "properties": {
              "type": {
                "type": "string",
                "const": "network"
              }
            },
            "required": [
              "type"
            ]
          },
          {
            "description": "The request exceeded `providers.*.timeout_s`.",
            "type": "object",
            "properties": {
              "type": {
                "type": "string",
                "const": "timeout"
              }
            },
            "required": [
              "type"
            ]
          },
          {
            "description": "The stream was cancelled via `Interrupt`.",
            "type": "object",
            "properties": {
              "type": {
                "type": "string",
                "const": "cancelled"
              }
            },
            "required": [
              "type"
            ]
          },
          {
            "description": "The SSE/JSON stream contained a line cox could not parse.",
            "type": "object",
            "properties": {
              "line": {
                "description": "1-based line number within the stream where parsing failed.",
                "type": "integer",
                "format": "uint64",
                "minimum": 0
              },
              "type": {
                "type": "string",
                "const": "parse"
              }
            },
            "required": [
              "type",
              "line"
            ]
          },
          {
            "description": "The request used a capability (`thinking`, `cache`, …) the provider lacks.",
            "type": "object",
            "properties": {
              "feature": {
                "description": "The capability name, matching a `Caps` field.",
                "type": "string"
              },
              "type": {
                "type": "string",
                "const": "unsupported"
              }
            },
            "required": [
              "type",
              "feature"
            ]
          }
        ]
      },
      "ToolError": {
        "description": "Failures from a `Tool` implementation (`cox-tools`, `cox-mcp`).",
        "oneOf": [
          {
            "description": "The permission engine denied the call before it ran.",
            "type": "object",
            "properties": {
              "why": {
                "description": "Human-readable reason, shown to the model so it can try another approach.",
                "type": "string"
              },
              "type": {
                "type": "string",
                "const": "denied"
              }
            },
            "required": [
              "type",
              "why"
            ]
          },
          {
            "description": "A path argument escaped every workspace root.",
            "type": "object",
            "properties": {
              "path": {
                "description": "The path the tool was given.",
                "type": "string"
              },
              "root": {
                "description": "The workspace root it failed to stay under.",
                "type": "string"
              },
              "type": {
                "type": "string",
                "const": "confined"
              }
            },
            "required": [
              "type",
              "path",
              "root"
            ]
          },
          {
            "description": "The sandbox refused the operation.",
            "type": "object",
            "properties": {
              "detail": {
                "description": "The sandbox backend's denial detail.",
                "type": "string"
              },
              "type": {
                "type": "string",
                "const": "sandbox_denied"
              }
            },
            "required": [
              "type",
              "detail"
            ]
          },
          {
            "description": "The tool exceeded its allotted time.",
            "type": "object",
            "properties": {
              "type": {
                "type": "string",
                "const": "timeout"
              }
            },
            "required": [
              "type"
            ]
          },
          {
            "description": "The target (file, path, id) does not exist.",
            "type": "object",
            "properties": {
              "type": {
                "type": "string",
                "const": "not_found"
              }
            },
            "required": [
              "type"
            ]
          },
          {
            "description": "An `edit` match was not unique.",
            "type": "object",
            "properties": {
              "matches": {
                "description": "The matching line numbers or excerpts, for the model to disambiguate.",
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "type": {
                "type": "string",
                "const": "ambiguous"
              }
            },
            "required": [
              "type",
              "matches"
            ]
          },
          {
            "description": "The output exceeded the archive/visible cap.",
            "type": "object",
            "properties": {
              "bytes": {
                "description": "The actual size in bytes.",
                "type": "integer",
                "format": "uint64",
                "minimum": 0
              },
              "cap": {
                "description": "The configured cap in bytes.",
                "type": "integer",
                "format": "uint64",
                "minimum": 0
              },
              "type": {
                "type": "string",
                "const": "too_large"
              }
            },
            "required": [
              "type",
              "bytes",
              "cap"
            ]
          },
          {
            "description": "The target file is binary; the tool refuses to read/edit it as text.",
            "type": "object",
            "properties": {
              "type": {
                "type": "string",
                "const": "binary"
              }
            },
            "required": [
              "type"
            ]
          },
          {
            "description": "Two workspace snapshots were taken over different root sets. Diffing\nthem would pair unrelated trees, so the change set is refused whole\nrather than reported partially.",
            "type": "object",
            "properties": {
              "before": {
                "description": "The roots of the earlier snapshot.",
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "after": {
                "description": "The roots of the later snapshot.",
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "type": {
                "type": "string",
                "const": "roots_mismatch"
              }
            },
            "required": [
              "type",
              "before",
              "after"
            ]
          },
          {
            "description": "A filesystem I/O error occurred.",
            "type": "object",
            "properties": {
              "type": {
                "type": "string",
                "const": "io"
              }
            },
            "required": [
              "type"
            ]
          },
          {
            "description": "The call was cancelled via the shared `CancellationToken`.",
            "type": "object",
            "properties": {
              "type": {
                "type": "string",
                "const": "cancelled"
              }
            },
            "required": [
              "type"
            ]
          }
        ]
      },
      "StoreError": {
        "description": "Failures from `cox-store`.",
        "oneOf": [
          {
            "description": "`cox.db` could not be opened.",
            "type": "object",
            "properties": {
              "type": {
                "type": "string",
                "const": "open"
              }
            },
            "required": [
              "type"
            ]
          },
          {
            "description": "A schema migration failed partway.",
            "type": "object",
            "properties": {
              "from": {
                "description": "The schema version migrated from.",
                "type": "integer",
                "format": "uint32",
                "minimum": 0
              },
              "to": {
                "description": "The schema version migration was attempting to reach.",
                "type": "integer",
                "format": "uint32",
                "minimum": 0
              },
              "type": {
                "type": "string",
                "const": "migrate"
              }
            },
            "required": [
              "type",
              "from",
              "to"
            ]
          },
          {
            "description": "The store file exists but failed an integrity check.",
            "type": "object",
            "properties": {
              "path": {
                "description": "Path to the corrupt file.",
                "type": "string"
              },
              "type": {
                "type": "string",
                "const": "corrupt"
              }
            },
            "required": [
              "type",
              "path"
            ]
          },
          {
            "description": "The requested row does not exist.",
            "type": "object",
            "properties": {
              "type": {
                "type": "string",
                "const": "not_found"
              }
            },
            "required": [
              "type"
            ]
          },
          {
            "description": "A filesystem I/O error occurred.",
            "type": "object",
            "properties": {
              "type": {
                "type": "string",
                "const": "io"
              }
            },
            "required": [
              "type"
            ]
          },
          {
            "description": "The underlying SQLite call failed.",
            "type": "object",
            "properties": {
              "type": {
                "type": "string",
                "const": "sqlite"
              }
            },
            "required": [
              "type"
            ]
          },
          {
            "description": "A plugin kv write went over quota (PL§3: 64 KiB per value, 1 MiB per\nplugin across all its keys).",
            "type": "object",
            "properties": {
              "type": {
                "type": "string",
                "const": "quota_exceeded"
              }
            },
            "required": [
              "type"
            ]
          },
          {
            "description": "`cox.db` holds a migration this binary does not embed: a newer `cox`\n(the app's bundled one, or a Homebrew one of another version) wrote\nit, and this older one must not read or write it (T37.36).",
            "type": "object",
            "properties": {
              "db": {
                "description": "The newest migration version in `cox.db` this binary does not know.",
                "type": "string"
              },
              "binary": {
                "description": "The newest migration version this binary embeds.",
                "type": "string"
              },
              "type": {
                "type": "string",
                "const": "schema_newer"
              }
            },
            "required": [
              "type",
              "db",
              "binary"
            ]
          }
        ]
      }
    }
  },
  "submission": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "title": "Submission",
    "description": "A submission into the core state machine: everything a surface can ask\n`cox-core` to do (plan.md §1.2/§1.3).\n\n# Example\n\n```rust\nuse cox_protocol::types::Submission;\n\n// Pressing Enter in the TUI sends this:\nlet sub = Submission::UserTurn {\n    text: \"create hello.txt containing hi\".into(),\n    attachments: vec![],\n    confirm_think: false,\n};\n// It serialises to the same snake_case JSON the rollout and\n// `cox run -p --output-format stream-json` use:\nlet json = serde_json::to_value(&sub).unwrap();\nassert_eq!(json[\"type\"], \"user_turn\");\n```",
    "oneOf": [
      {
        "description": "Start (or continue) a turn with user text.",
        "type": "object",
        "properties": {
          "text": {
            "description": "The submitted text.",
            "type": "string"
          },
          "attachments": {
            "description": "Attached files/images.",
            "type": "array",
            "items": {
              "$ref": "#/$defs/Attachment"
            }
          },
          "confirm_think": {
            "description": "`true` runs this one turn on `Tier::Think` (`/think`, the think\ntoggle, `--deep`), confirming its gate (plan.md invariant #9); the\nnext turn without it goes back to the session's tier (D5, A103).",
            "type": "boolean"
          },
          "type": {
            "type": "string",
            "const": "user_turn"
          }
        },
        "required": [
          "type",
          "text",
          "attachments",
          "confirm_think"
        ]
      },
      {
        "description": "Answer a pending `ApprovalRequired`.",
        "type": "object",
        "properties": {
          "call_id": {
            "description": "The call being decided.",
            "$ref": "#/$defs/CallId"
          },
          "decision": {
            "description": "The decision.",
            "$ref": "#/$defs/Decision"
          },
          "type": {
            "type": "string",
            "const": "approve"
          }
        },
        "required": [
          "type",
          "call_id",
          "decision"
        ]
      },
      {
        "description": "The person's reply to a `QuestionAsked` (DT G4).",
        "type": "object",
        "properties": {
          "call_id": {
            "description": "The `ask_user` call being answered.",
            "$ref": "#/$defs/CallId"
          },
          "text": {
            "description": "The answer; `None` dismisses the question unanswered.",
            "type": [
              "string",
              "null"
            ]
          },
          "type": {
            "type": "string",
            "const": "answer"
          }
        },
        "required": [
          "type",
          "call_id"
        ]
      },
      {
        "description": "Cancel the running turn; tools get the shared cancellation token.",
        "type": "object",
        "properties": {
          "type": {
            "type": "string",
            "const": "interrupt"
          }
        },
        "required": [
          "type"
        ]
      },
      {
        "description": "Compact the session now, optionally focused on something specific.",
        "type": "object",
        "properties": {
          "focus": {
            "description": "What the summary should emphasise, if given.",
            "type": [
              "string",
              "null"
            ]
          },
          "type": {
            "type": "string",
            "const": "compact"
          }
        },
        "required": [
          "type"
        ]
      },
      {
        "description": "Change the tier's model for the rest of the session.",
        "type": "object",
        "properties": {
          "tier": {
            "description": "Which tier to change.",
            "$ref": "#/$defs/Tier"
          },
          "model": {
            "description": "The model to switch to; `None` restores the tier's configured default.",
            "anyOf": [
              {
                "$ref": "#/$defs/ModelId"
              },
              {
                "type": "null"
              }
            ]
          },
          "type": {
            "type": "string",
            "const": "switch_model"
          }
        },
        "required": [
          "type",
          "tier"
        ]
      },
      {
        "description": "`/effort`: the effort every main-turn call runs at for the rest of\nthe session, clamped to what the routed model supports; `None`\nrestores the tier default (T16.4).",
        "type": "object",
        "properties": {
          "effort": {
            "description": "The level, or `None` for the tier default.",
            "anyOf": [
              {
                "$ref": "#/$defs/Effort"
              },
              {
                "type": "null"
              }
            ]
          },
          "type": {
            "type": "string",
            "const": "set_effort"
          }
        },
        "required": [
          "type"
        ]
      },
      {
        "description": "Change the active permission mode.",
        "type": "object",
        "properties": {
          "mode": {
            "description": "The new mode.",
            "$ref": "#/$defs/PermissionMode"
          },
          "type": {
            "type": "string",
            "const": "set_permission_mode"
          }
        },
        "required": [
          "type",
          "mode"
        ]
      },
      {
        "description": "Revoke an `AllowForSession` grant (T37.45.3): the next call it\ncovered goes back through the rules and asks. The core answers with\n`GrantRevoked`, which resume replays, so the grant stays gone.",
        "type": "object",
        "properties": {
          "tool": {
            "description": "The grant's tool, as `grants_for` recorded it.",
            "type": "string"
          },
          "subject": {
            "description": "The grant's subject prefix.",
            "type": "string"
          },
          "type": {
            "type": "string",
            "const": "revoke_grant"
          }
        },
        "required": [
          "type",
          "tool",
          "subject"
        ]
      },
      {
        "description": "A slash command the surface parsed but did not resolve itself.",
        "type": "object",
        "properties": {
          "command": {
            "description": "The parsed command.",
            "$ref": "#/$defs/SlashCommand"
          },
          "type": {
            "type": "string",
            "const": "command"
          }
        },
        "required": [
          "type",
          "command"
        ]
      },
      {
        "description": "A hook runner's result for a hook the core is waiting on.",
        "type": "object",
        "properties": {
          "hook_id": {
            "description": "The hook invocation's id.",
            "type": "string"
          },
          "outcome": {
            "description": "The outcome.",
            "$ref": "#/$defs/HookOutcome"
          },
          "type": {
            "type": "string",
            "const": "hook_result"
          }
        },
        "required": [
          "type",
          "hook_id",
          "outcome"
        ]
      },
      {
        "description": "`/rewind` (T26.2): restore the workspace, the conversation or both\nto the start of turn `to_turn`.",
        "type": "object",
        "properties": {
          "to_turn": {
            "description": "The turn to go back to (its `seq`); that turn and later ones are undone.",
            "type": "integer",
            "format": "uint32",
            "minimum": 0
          },
          "code": {
            "description": "Write every pre-image since `to_turn` back into the workspace.",
            "type": "boolean"
          },
          "conversation": {
            "description": "Drop the conversation from `to_turn` on (append-only: a marker, not an edit).",
            "type": "boolean"
          },
          "type": {
            "type": "string",
            "const": "rewind"
          }
        },
        "required": [
          "type",
          "to_turn",
          "code",
          "conversation"
        ]
      },
      {
        "description": "`/redo` (T26.4): put back the files the last rewind restored, when\nnothing has happened since it. One step; a warning otherwise.",
        "type": "object",
        "properties": {
          "type": {
            "type": "string",
            "const": "redo"
          }
        },
        "required": [
          "type"
        ]
      },
      {
        "description": "Revert one file (T37.28.3, A101): write back its pre-image from\nbefore `to_turn` first touched it, checkpointing its current bytes\nfirst so the revert can itself be undone. Nothing else changes.",
        "type": "object",
        "properties": {
          "path": {
            "description": "Relative to the session's cwd or absolute; confined to the\nworkspace roots like a tool's path.",
            "type": "string"
          },
          "to_turn": {
            "description": "The turn to go back before.",
            "type": "integer",
            "format": "uint32",
            "minimum": 0
          },
          "type": {
            "type": "string",
            "const": "revert_file"
          }
        },
        "required": [
          "type",
          "path",
          "to_turn"
        ]
      },
      {
        "description": "Put one of Review's hunks back (T51.19, A101): hunk `hunk` of the\nfile's net diff, from its first pre-image since `to_turn` to its\nbytes on disk, written back to the pre-image's lines alone. The\ncurrent bytes are checkpointed first so the revert can itself be\nundone; a file whose [`content_digest`] is no longer `now_digest` is\nleft as it is, with a Notice.",
        "type": "object",
        "properties": {
          "path": {
            "description": "Relative to the session's cwd or absolute; confined to the\nworkspace roots like a tool's path.",
            "type": "string"
          },
          "to_turn": {
            "description": "The turn whose pre-image the diff starts from.",
            "type": "integer",
            "format": "uint32",
            "minimum": 0
          },
          "hunk": {
            "description": "The hunk's index in Review's diff, from 0.",
            "type": "integer",
            "format": "uint32",
            "minimum": 0
          },
          "now_digest": {
            "description": "[`content_digest`] of the bytes Review diffed.",
            "type": "string"
          },
          "type": {
            "type": "string",
            "const": "revert_hunk"
          }
        },
        "required": [
          "type",
          "path",
          "to_turn",
          "hunk",
          "now_digest"
        ]
      },
      {
        "description": "`Ctrl+B` (T27.1): detach a running `bash` or `agent` call into a\nbackground task; the model gets a pointer result and the turn goes on.",
        "type": "object",
        "properties": {
          "call_id": {
            "description": "The running call to detach.",
            "$ref": "#/$defs/CallId"
          },
          "type": {
            "type": "string",
            "const": "background"
          }
        },
        "required": [
          "type",
          "call_id"
        ]
      },
      {
        "description": "A composer `!` line (T25.3): `bash` runs under the same hooks,\npermission engine and sandbox as a model call. Only `share` (`!!`)\nlets the output into history; otherwise the next request is\nbyte-identical to the one before it.",
        "type": "object",
        "properties": {
          "command": {
            "description": "The command line, without the `!`/`!!`.",
            "type": "string"
          },
          "share": {
            "description": "`!!`: append the output to history for the model.",
            "type": "boolean"
          },
          "type": {
            "type": "string",
            "const": "user_shell"
          }
        },
        "required": [
          "type",
          "command",
          "share"
        ]
      },
      {
        "description": "A composer `@name task` line (T45.5): runs subagent `name` through the\n`agent` tool on the model's own path (hooks, permission engine,\nbudget, agent slots). The line and the answer join history at its\ntail, so the next model turn sees them.",
        "type": "object",
        "properties": {
          "name": {
            "description": "A preset, agent definition or external agent name.",
            "type": "string"
          },
          "task": {
            "description": "What the subagent is asked to do.",
            "type": "string"
          },
          "type": {
            "type": "string",
            "const": "user_agent"
          }
        },
        "required": [
          "type",
          "name",
          "task"
        ]
      },
      {
        "description": "Wind down the session cleanly.",
        "type": "object",
        "properties": {
          "type": {
            "type": "string",
            "const": "shutdown"
          }
        },
        "required": [
          "type"
        ]
      },
      {
        "description": "`/rename`, or a rename in the app (A113, T37.22.9): the session's\ntitle, set by the user. The core answers with a `TitleSet` marked\n`by_user`, which a generated title never replaces.",
        "type": "object",
        "properties": {
          "title": {
            "description": "The new title; the core keeps its first line, sanitized.",
            "type": "string"
          },
          "type": {
            "type": "string",
            "const": "rename"
          }
        },
        "required": [
          "type",
          "title"
        ]
      },
      {
        "description": "A follow-up for a background task, addressed by `TaskId` (T34.4,\nSM§1). Only ever submitted to the **parent** session: `from: None`\nis the parent/user, `Some(id)` a sibling relayed through the parent\n(SM§3). `hop` is set only by the parent and never trusted from a\ntool call (SM§5); T34.5 gives it a router, T34.6 the tool that\nproduces it.",
        "type": "object",
        "properties": {
          "task": {
            "description": "The task the message is addressed to.",
            "$ref": "#/$defs/TaskId"
          },
          "from": {
            "description": "Who it is from; `None` for the parent/user, `Some` for a sibling.",
            "anyOf": [
              {
                "$ref": "#/$defs/TaskId"
              },
              {
                "type": "null"
              }
            ]
          },
          "hop": {
            "description": "How many relays this message has been through (SM§5's loop guard).",
            "type": "integer",
            "format": "uint32",
            "minimum": 0
          },
          "text": {
            "description": "The message text.",
            "type": "string"
          },
          "type": {
            "type": "string",
            "const": "task_message"
          }
        },
        "required": [
          "type",
          "task",
          "hop",
          "text"
        ]
      }
    ],
    "$defs": {
      "Attachment": {
        "description": "A file, image or other blob attached to a `UserTurn`.",
        "type": "object",
        "properties": {
          "name": {
            "description": "Display name (usually the original filename).",
            "type": "string"
          },
          "media_type": {
            "description": "MIME type, e.g. `\"image/png\"`.",
            "type": "string"
          },
          "data_b64": {
            "description": "Base64-encoded bytes.",
            "type": "string"
          }
        },
        "required": [
          "name",
          "media_type",
          "data_b64"
        ]
      },
      "CallId": {
        "description": "CallId: a 26-character Crockford-base32 ULID.",
        "type": "string",
        "pattern": "^[0-7][0-9A-HJKMNP-TV-Z]{25}$"
      },
      "Decision": {
        "description": "An approval decision, for both `Submission::Approve` and `ApprovalDecided`.",
        "oneOf": [
          {
            "description": "Run the call once.",
            "type": "object",
            "properties": {
              "type": {
                "type": "string",
                "const": "allow"
              }
            },
            "required": [
              "type"
            ]
          },
          {
            "description": "Run this call and grant future calls with the same tool + subject prefix, for this session.",
            "type": "object",
            "properties": {
              "type": {
                "type": "string",
                "const": "allow_for_session"
              }
            },
            "required": [
              "type"
            ]
          },
          {
            "description": "Refuse the call.",
            "type": "object",
            "properties": {
              "reason": {
                "description": "Shown to the model as the tool result.",
                "type": "string"
              },
              "type": {
                "type": "string",
                "const": "deny"
              }
            },
            "required": [
              "type",
              "reason"
            ]
          },
          {
            "description": "Run the call, but with edited input (e.g. a corrected path).",
            "type": "object",
            "properties": {
              "input": {
                "description": "The replacement input."
              },
              "type": {
                "type": "string",
                "const": "edit"
              }
            },
            "required": [
              "type",
              "input"
            ]
          }
        ]
      },
      "Tier": {
        "description": "A routing tier (plan.md §1.4/D5): a job maps to a tier, a tier maps to a model.\n\nOrdered cheapest first (declaration order), the one tier ordering every\n\"never up\" rule compares with: a plugin's model-call grant clamp\n(PL§7d) and the `route` decision point (PL§4, T33.20).",
        "oneOf": [
          {
            "description": "Haiku-class or local; mechanical work, never chosen for the main coding turn.",
            "type": "string",
            "const": "cheap"
          },
          {
            "description": "Sonnet by default, Opus when picked; the main coding turn.",
            "type": "string",
            "const": "code"
          },
          {
            "description": "Fable 5.1 only, only via `/think`/`--deep`, always confirmed.",
            "type": "string",
            "const": "think"
          }
        ]
      },
      "ModelId": {
        "description": "A newtype around a provider's model identifier (e.g. `\"claude-sonnet-5\"`).\nDeliberately a bare string, not an enum: models are configured, not\ncompiled in (`config/default.toml` [tiers.*].model).",
        "type": "string"
      },
      "Effort": {
        "description": "Reasoning effort passed to the provider.\n\nOrdered `Low < Medium < High < Xhigh` so the router can clamp a tier's\neffort to the greatest level a model supports (`docs/design/providers.md`).\nThe four levels are models.dev's own, so a catalog row maps without loss\n(T30.26).",
        "oneOf": [
          {
            "description": "Cheapest, fastest; used for `cheap`-tier jobs.",
            "type": "string",
            "const": "low"
          },
          {
            "description": "Between `Low` and `High`: models.dev's and the wires' `medium`.",
            "type": "string",
            "const": "medium"
          },
          {
            "description": "Default for `code`/`think` tiers.",
            "type": "string",
            "const": "high"
          },
          {
            "description": "User-selected for a flagged large refactor.",
            "type": "string",
            "const": "xhigh"
          }
        ]
      },
      "PermissionMode": {
        "description": "`permissions.mode` (plan.md §1.6/§1.8).",
        "oneOf": [
          {
            "description": "Rules and risk decide as usual.",
            "type": "string",
            "const": "default"
          },
          {
            "description": "Only `Risk::ReadOnly` is allowed; everything else denies without asking.",
            "type": "string",
            "const": "plan"
          },
          {
            "description": "`Write` is allowed automatically; `Exec`/`Destructive` still ask unless a safe-command match.",
            "type": "string",
            "const": "auto"
          },
          {
            "description": "Everything is allowed; flag-only, banner shown.",
            "type": "string",
            "const": "bypass"
          }
        ]
      },
      "SlashCommand": {
        "description": "A parsed `.claude/commands/*.md`-style slash command the surface could\nnot resolve to a built-in `Submission` variant, forwarded to `cox-ext`\nfor execution.",
        "type": "object",
        "properties": {
          "name": {
            "description": "The command name, without the leading `/`.",
            "type": "string"
          },
          "args": {
            "description": "Everything after the command name, already tokenized.",
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "required": [
          "name",
          "args"
        ]
      },
      "HookOutcome": {
        "description": "A hook runner's verdict for one hook invocation (plan.md §1.2).",
        "oneOf": [
          {
            "description": "Proceed unchanged.",
            "type": "object",
            "properties": {
              "type": {
                "type": "string",
                "const": "continue"
              }
            },
            "required": [
              "type"
            ]
          },
          {
            "description": "Stop the action the hook gated.",
            "type": "object",
            "properties": {
              "reason": {
                "description": "Shown to the user/model as the reason.",
                "type": "string"
              },
              "type": {
                "type": "string",
                "const": "block"
              }
            },
            "required": [
              "type",
              "reason"
            ]
          },
          {
            "description": "Proceed with different input (e.g. a rewritten prompt or tool input).",
            "type": "object",
            "properties": {
              "input": {
                "description": "The replacement input."
              },
              "type": {
                "type": "string",
                "const": "modify"
              }
            },
            "required": [
              "type",
              "input"
            ]
          },
          {
            "description": "The hook itself failed to run; fail-open per D14/AGENTS.md.",
            "type": "object",
            "properties": {
              "error": {
                "description": "What went wrong (timeout, non-zero exit, bad JSON).",
                "type": "string"
              },
              "type": {
                "type": "string",
                "const": "failed"
              }
            },
            "required": [
              "type",
              "error"
            ]
          }
        ]
      },
      "TaskId": {
        "description": "TaskId: a 26-character Crockford-base32 ULID.",
        "type": "string",
        "pattern": "^[0-7][0-9A-HJKMNP-TV-Z]{25}$"
      }
    }
  }
}
