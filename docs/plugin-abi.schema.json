{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "cox plugin ABI v1",
  "description": "Payloads of the cox:host/v1 ABI (docs/design/plugins.md §4). A field marked x-cox-protocol carries that cox_protocol type unchanged; see docs/protocol.jsonschema.",
  "$defs": {
    "InitIn": {
      "type": "object",
      "properties": {
        "api": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0,
          "description": "The ABI major the host speaks."
        },
        "plugin_id": {
          "type": "string",
          "description": "The plugin's own id."
        },
        "config": {
          "description": "The `[plugins.<id>]` config table; the plugin validates it itself."
        },
        "session": {
          "$ref": "#/$defs/SessionInfo",
          "description": "The session the plugin is loaded into."
        },
        "granted": {
          "description": "The granted subset of the manifest's `[capabilities]`, same keys.\nJSON rather than `Capabilities`, which denies unknown keys: a\ncapability added in a later minor must not break an older guest."
        },
        "surface": {
          "anyOf": [
            {
              "$ref": "#/$defs/Surface"
            },
            {
              "type": "null"
            }
          ],
          "description": "Who drives the session, so a plugin returns only its surface's parts.\nAbsent from a cox older than PL§15; a guest reads absence as\n`terminal`, the only surface plugins were written for.",
          "default": null
        }
      },
      "required": [
        "api",
        "plugin_id",
        "config",
        "session",
        "granted"
      ],
      "description": "`cox_init` input: once per session."
    },
    "SessionInfo": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "The session id."
        },
        "cwd": {
          "type": "string",
          "description": "The workspace root."
        }
      },
      "required": [
        "id",
        "cwd"
      ],
      "description": "The session a plugin is initialised for."
    },
    "Surface": {
      "oneOf": [
        {
          "type": "string",
          "const": "terminal",
          "description": "The TUI and `cox --plain`."
        },
        {
          "type": "string",
          "const": "desktop",
          "description": "The macOS app, local or over `cox app-server`."
        },
        {
          "type": "string",
          "const": "headless",
          "description": "`cox run -p`."
        },
        {
          "type": "string",
          "const": "acp",
          "description": "`cox acp`."
        }
      ],
      "description": "A place a plugin can run: who drives the session (PL§15.1)."
    },
    "InitOut": {
      "type": "object",
      "properties": {
        "tools": {
          "type": "array",
          "items": {
            "x-cox-protocol": "ToolSpec"
          },
          "description": "Tool specs, frozen for the session (PL§7).",
          "default": []
        },
        "commands": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/CommandDecl"
          },
          "description": "Slash commands, shown as `/<id>:<name>`.",
          "default": []
        },
        "keys": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/KeyDecl"
          },
          "description": "Keys, reachable as `<leader> <key>`.",
          "default": []
        },
        "status": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Slot"
          },
          "description": "Status segments the plugin fills (`status.left`, `status.right`).",
          "default": []
        },
        "panels": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Slot"
          },
          "description": "Panel and overlay slots the plugin fills (`panel`, `overlay`).",
          "default": []
        },
        "renderers": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Render targets it serves: `tool:<name>` or `item:assistant_message`.",
          "default": []
        },
        "subscribe": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "`Event` serde tags it wants in `cox_on_event`.",
          "default": []
        },
        "desktop": {
          "$ref": "#/$defs/DesktopOut",
          "description": "Desktop-only contributions; dropped with a notice on any other\nsurface (PL§15.6).",
          "default": {
            "inspector": null,
            "toolbar": [],
            "palette": [],
            "canvas": null
          }
        }
      },
      "description": "`cox_init` output: what the plugin contributes. Anything not granted is\ndropped by the host with a notice; every field may be omitted."
    },
    "CommandDecl": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string",
          "description": "Name after `/<id>:`."
        },
        "description": {
          "type": "string",
          "description": "One line for the palette.",
          "default": ""
        }
      },
      "required": [
        "name"
      ],
      "description": "A slash command a plugin offers."
    },
    "KeyDecl": {
      "type": "object",
      "properties": {
        "key": {
          "type": "string",
          "description": "The key as `keybindings.toml` spells it."
        },
        "name": {
          "type": "string",
          "description": "The name passed in `CommandIn`."
        },
        "description": {
          "type": "string",
          "description": "One line for the help overlay.",
          "default": ""
        }
      },
      "required": [
        "key",
        "name"
      ],
      "description": "A key under the plugin leader; pressing it calls `cox_key` with `name`."
    },
    "Slot": {
      "oneOf": [
        {
          "type": "string",
          "const": "status.left",
          "description": "Left segment of the status row."
        },
        {
          "type": "string",
          "const": "status.right",
          "description": "Right segment of the status row."
        },
        {
          "type": "string",
          "const": "panel",
          "description": "Rows above the composer."
        },
        {
          "type": "string",
          "const": "overlay",
          "description": "Full-screen overlay."
        },
        {
          "type": "string",
          "const": "desktop.inspector",
          "description": "The desktop inspector tab (PL§15.4); asked for only after the plugin\ndeclared `InitOut.desktop.inspector`, so an older guest never sees it."
        }
      ],
      "description": "A TUI slot (PL§8)."
    },
    "DesktopOut": {
      "type": "object",
      "properties": {
        "inspector": {
          "anyOf": [
            {
              "$ref": "#/$defs/TabDecl"
            },
            {
              "type": "null"
            }
          ],
          "description": "One inspector tab, filled by `cox_render` with `Slot::DesktopInspector`.",
          "default": null
        },
        "toolbar": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/ActionDecl"
          },
          "description": "Toolbar items, at most [`MAX_TOOLBAR_ACTIONS`].",
          "default": []
        },
        "palette": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/ActionDecl"
          },
          "description": "Command-palette actions.",
          "default": []
        },
        "canvas": {
          "anyOf": [
            {
              "$ref": "#/$defs/CanvasDecl"
            },
            {
              "type": "null"
            }
          ],
          "description": "The canvas pane, filled by `cox_canvas`\n(`docs/design/plugin-canvas.md`).",
          "default": null
        }
      },
      "description": "What `InitOut.desktop` carries (PL§15.4). The app draws each one natively\nfrom this data; a plugin never supplies UI code."
    },
    "TabDecl": {
      "type": "object",
      "properties": {
        "title": {
          "type": "string",
          "description": "The tab's title."
        },
        "symbol": {
          "type": "string",
          "description": "An SF Symbol name; see [`is_symbol_name`]."
        }
      },
      "required": [
        "title",
        "symbol"
      ],
      "description": "The inspector tab a plugin adds."
    },
    "ActionDecl": {
      "type": "object",
      "properties": {
        "command": {
          "type": "string",
          "description": "One of the plugin's `InitOut.commands` names."
        },
        "title": {
          "type": "string",
          "description": "The label, or the tooltip for a toolbar icon."
        },
        "symbol": {
          "type": "string",
          "description": "An SF Symbol name; see [`is_symbol_name`]."
        }
      },
      "required": [
        "command",
        "title",
        "symbol"
      ],
      "description": "A toolbar item or palette action. A click goes through `cox_command`, so\nit cannot submit anything a command could not."
    },
    "CanvasDecl": {
      "type": "object",
      "properties": {
        "title": {
          "type": "string",
          "description": "The pane's title, 1–64 characters."
        },
        "symbol": {
          "type": "string",
          "description": "An SF Symbol name; see [`is_symbol_name`]."
        },
        "select_attr": {
          "type": "string",
          "description": "The attribute a click reports, from the nearest element carrying it:\n`data-` and 1–48 of `[a-z0-9-]`."
        }
      },
      "required": [
        "title",
        "symbol",
        "select_attr"
      ],
      "description": "The canvas pane a plugin adds. Its pages are static HTML the app shows\nwith page script, loads and navigation off; only the app's own script\nreports a click (`docs/design/plugin-canvas.md` §4)."
    },
    "EventBatch": {
      "type": "object",
      "properties": {
        "first_seq": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0,
          "description": "Sequence number of the first event in `events`."
        },
        "dropped": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0,
          "description": "Events dropped from the ring since the last batch."
        },
        "events": {
          "type": "array",
          "items": {
            "x-cox-protocol": "Event"
          },
          "description": "Scrubbed events, in rollout order."
        }
      },
      "required": [
        "first_seq",
        "dropped",
        "events"
      ],
      "description": "`cox_on_event` input (PL§5)."
    },
    "Effects": {
      "type": "object",
      "properties": {
        "redraw": {
          "type": "boolean",
          "description": "Re-render this plugin's slots.",
          "default": false
        },
        "notices": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/PluginNotice"
          },
          "description": "Notices to show.",
          "default": []
        }
      },
      "description": "`cox_on_event` output."
    },
    "PluginNotice": {
      "type": "object",
      "properties": {
        "level": {
          "$ref": "#/$defs/NoticeLevel",
          "description": "Severity, capped at `warn`."
        },
        "text": {
          "type": "string",
          "description": "Shown sanitized."
        }
      },
      "required": [
        "level",
        "text"
      ],
      "description": "A notice from a plugin."
    },
    "NoticeLevel": {
      "oneOf": [
        {
          "type": "string",
          "const": "info",
          "description": "Informational."
        },
        {
          "type": "string",
          "const": "warn",
          "description": "Something degraded."
        }
      ],
      "description": "The notice levels a plugin may use. Not `cox_protocol::Level`: that one\nhas `budget` and `security`, which a plugin must never raise (PL§4)."
    },
    "HookCall": {
      "type": "object",
      "properties": {
        "event": {
          "description": "Which hook fired.",
          "x-cox-protocol": "HookEvent"
        },
        "payload": {
          "description": "The hook's JSON input, as shell hooks get it on stdin."
        }
      },
      "required": [
        "event",
        "payload"
      ],
      "description": "`cox_hook` input (PL§6); the output is a `HookOutcome`."
    },
    "ToolCallIn": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string",
          "description": "The tool's name inside the plugin, without `wasm__<id>__`."
        },
        "input": {
          "description": "The model's input."
        }
      },
      "required": [
        "name",
        "input"
      ],
      "description": "`cox_tool_subject` / `cox_tool_risk` / `cox_tool_call` input: the `Tool`\ntrait serialised. Outputs are a string, a `Risk` and a `ToolOutput`."
    },
    "CommandIn": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string",
          "description": "The command or key name the plugin declared."
        },
        "args": {
          "type": "string",
          "description": "Text after the command; empty for a key.",
          "default": ""
        }
      },
      "required": [
        "name"
      ],
      "description": "`cox_command` / `cox_key` input."
    },
    "CommandOut": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "text": {
              "type": "string",
              "description": "The prompt text."
            },
            "kind": {
              "type": "string",
              "const": "prompt"
            }
          },
          "required": [
            "kind",
            "text"
          ],
          "description": "Submitted as a `UserTurn`, like a markdown command."
        },
        {
          "type": "object",
          "properties": {
            "focus": {
              "type": [
                "string",
                "null"
              ],
              "description": "What the summary should keep.",
              "default": null
            },
            "kind": {
              "type": "string",
              "const": "compact"
            }
          },
          "required": [
            "kind"
          ],
          "description": "Compact now."
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "toggle_panel"
            }
          },
          "required": [
            "kind"
          ],
          "description": "Show or hide the plugin's panel."
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "open_overlay"
            }
          },
          "required": [
            "kind"
          ],
          "description": "Open the plugin's overlay."
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "open_inspector"
            }
          },
          "required": [
            "kind"
          ],
          "description": "Select the plugin's inspector tab: the desktop counterpart of\n`OpenOverlay`, dropped with a notice on the terminal."
        },
        {
          "$ref": "#/$defs/PluginNotice",
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "notice"
            }
          },
          "required": [
            "kind"
          ],
          "description": "Show a notice."
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "nothing"
            }
          },
          "required": [
            "kind"
          ],
          "description": "Do nothing."
        }
      ],
      "description": "`cox_command` / `cox_key` output. Closed on purpose: there is no\n`Submission` variant, so a plugin cannot switch the permission mode,\napprove a call or switch the model up (PL§4)."
    },
    "RenderIn": {
      "type": "object",
      "properties": {
        "slot": {
          "$ref": "#/$defs/Slot",
          "description": "The slot to fill."
        },
        "width": {
          "type": "integer",
          "format": "uint16",
          "minimum": 0,
          "maximum": 65535,
          "description": "Columns available."
        },
        "height": {
          "type": "integer",
          "format": "uint16",
          "minimum": 0,
          "maximum": 65535,
          "description": "Rows available."
        }
      },
      "required": [
        "slot",
        "width",
        "height"
      ],
      "description": "`cox_render` input; the output is a `Widget`."
    },
    "RenderItemIn": {
      "type": "object",
      "properties": {
        "target": {
          "type": "string",
          "description": "The renderer target that matched."
        },
        "call": {
          "description": "The call, for a `tool:<name>` target.",
          "default": null,
          "x-cox-protocol": "ToolCall"
        },
        "result": {
          "description": "The tool's output, or the assistant item for `item:assistant_message`."
        },
        "width": {
          "type": "integer",
          "format": "uint16",
          "minimum": 0,
          "maximum": 65535,
          "description": "Columns available."
        }
      },
      "required": [
        "target",
        "result",
        "width"
      ],
      "description": "`cox_render_item` input; the output is an optional `Widget`."
    },
    "ProviderCall": {
      "type": "object",
      "properties": {
        "request": {
          "description": "The provider-neutral request.",
          "x-cox-protocol": "Request"
        },
        "model": {
          "type": "string",
          "description": "The model id to send."
        },
        "base_url": {
          "type": [
            "string",
            "null"
          ],
          "description": "The section's base URL as the host bound it, which a user config may\noverride (T33.40.4); `cox_http` allows only this host. Absent from an\nolder host, so a guest falls back to its manifest's `base_url`."
        }
      },
      "required": [
        "request",
        "model"
      ],
      "description": "`cox_provider_stream` input (PL§7a); the output is `Vec<ProviderEvent>`."
    },
    "ModelCall": {
      "type": "object",
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "tier": {
              "$ref": "#/$defs/ModelTier",
              "description": "The tier to route at."
            }
          },
          "required": [
            "tier"
          ],
          "description": "The router's pick for a tier; the host clamps it to the grant, never\n`think`. The only target `cox_model_call` takes."
        },
        {
          "type": "object",
          "properties": {
            "own_provider": {
              "$ref": "#/$defs/OwnProvider",
              "description": "The section and the model to send."
            }
          },
          "required": [
            "own_provider"
          ],
          "description": "One of the plugin's own `[[provider]]` sections, run by the host\nafter `cox_decide` returns (`DecideOut::Call`), never from inside an\nexport: the plugin's one worker would be waiting on itself."
        }
      ],
      "description": "`cox_model_call` input (PL§7d), and what `DecideOut::Call` asks the host\nto run (T33.40.1); the output is `Vec<ProviderEvent>`.",
      "properties": {
        "request": {
          "description": "The request; the host sets its tier, model and job.",
          "x-cox-protocol": "Request"
        }
      },
      "required": [
        "request"
      ]
    },
    "ModelTier": {
      "oneOf": [
        {
          "type": "string",
          "const": "cheap",
          "description": "The low-cost tier."
        },
        {
          "type": "string",
          "const": "code",
          "description": "The coding tier; must be named explicitly."
        }
      ],
      "description": "The highest tier a plugin may ask the router for. `think` is not a\nvariant, so no manifest can request it (D5)."
    },
    "OwnProvider": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string",
          "description": "The `[[provider]]` section name."
        },
        "model": {
          "type": "string",
          "description": "The model id to send."
        }
      },
      "required": [
        "name",
        "model"
      ],
      "description": "A plugin's own provider section and the model to ask it for."
    },
    "HttpReq": {
      "type": "object",
      "properties": {
        "method": {
          "type": "string",
          "description": "HTTP method."
        },
        "url": {
          "type": "string",
          "description": "Full URL; its host must be allowed in this context."
        },
        "headers": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          },
          "description": "Request headers.",
          "default": {}
        },
        "body": {
          "type": [
            "string",
            "null"
          ],
          "description": "UTF-8 body.",
          "default": null
        }
      },
      "required": [
        "method",
        "url"
      ],
      "description": "`cox_http` input."
    },
    "HttpResp": {
      "type": "object",
      "properties": {
        "status": {
          "type": "integer",
          "format": "uint16",
          "minimum": 0,
          "maximum": 65535,
          "description": "HTTP status."
        },
        "headers": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          },
          "description": "Response headers; repeated ones are joined with `, `.",
          "default": {}
        },
        "body": {
          "type": "string",
          "description": "UTF-8 body, capped at `max_http_response_bytes`.",
          "default": ""
        }
      },
      "required": [
        "status"
      ],
      "description": "`cox_http` output."
    },
    "Question": {
      "type": "object",
      "properties": {
        "point": {
          "$ref": "#/$defs/DecidePoint",
          "description": "Which point asks."
        },
        "state": {
          "description": "What the answer is about, redacted."
        },
        "options": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "The choices the core offers (tiers for `route`, candidates for\n`rank`); empty for a score or yes/no point.",
          "default": []
        },
        "items": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/QuestionItem"
          },
          "description": "A batched question (J10): one request covers every item a point\nneeds, such as each call of one tool batch, instead of one request\nper item. Empty for a single question; otherwise `state` holds what\nthe items share and the answer is [`Answer::Items`].",
          "default": []
        }
      },
      "required": [
        "point",
        "state"
      ],
      "description": "`cox_decide` input: the core offers the options and keeps the decision."
    },
    "DecidePoint": {
      "oneOf": [
        {
          "type": "string",
          "const": "route",
          "description": "Tier for a user turn; only down."
        },
        {
          "type": "string",
          "const": "risk",
          "description": "Severity of a tool call; only up."
        },
        {
          "type": "string",
          "const": "approve_hint",
          "description": "A caution note on the approval modal; never \"looks safe\"."
        },
        {
          "type": "string",
          "const": "compact",
          "description": "Compact now; only earlier."
        },
        {
          "type": "string",
          "const": "rank",
          "description": "Reorder or filter candidates; never add."
        },
        {
          "type": "string",
          "const": "salience",
          "description": "Salience of a memory item."
        }
      ],
      "description": "A decision point (PL§4 \"Decision points\")."
    },
    "QuestionItem": {
      "type": "object",
      "properties": {
        "state": {
          "description": "What this item is about, redacted."
        },
        "options": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "This item's choices; empty for a score or yes/no point.",
          "default": []
        }
      },
      "required": [
        "state"
      ],
      "description": "One item of a batched [`Question`]."
    },
    "Advice": {
      "type": "object",
      "properties": {
        "answer": {
          "$ref": "#/$defs/Answer",
          "description": "The answer."
        },
        "confidence": {
          "type": [
            "number",
            "null"
          ],
          "format": "double",
          "description": "In `[0, 1]`; absent when the model gives none (a yes/no, J11).",
          "default": null
        },
        "note": {
