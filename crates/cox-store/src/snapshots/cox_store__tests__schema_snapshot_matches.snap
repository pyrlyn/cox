---
source: crates/cox-store/src/lib.rs
expression: rendered
---
-- archive
CREATE TABLE archive (
  id TEXT PRIMARY KEY, session_id TEXT NOT NULL, call_id TEXT NOT NULL, tool TEXT NOT NULL,
  subject TEXT, bytes INTEGER NOT NULL, sha256 TEXT NOT NULL,
  inline BLOB, path TEXT, created_at TEXT NOT NULL,
  CHECK ((inline IS NULL) <> (path IS NULL))
);

-- checkpoints
CREATE TABLE checkpoints (
  id INTEGER PRIMARY KEY, session_id TEXT NOT NULL, turn INTEGER NOT NULL, call_id TEXT,
  path TEXT NOT NULL, kind TEXT NOT NULL CHECK (kind IN ('pre','created','deleted','turn')),
  archive_id TEXT, created_at TEXT NOT NULL
);

-- checkpoints_session
CREATE INDEX checkpoints_session ON checkpoints(session_id, turn);

-- cloud_runs
CREATE TABLE cloud_runs (
  backend TEXT NOT NULL, run_id TEXT NOT NULL,
  session_id TEXT NOT NULL, task_id TEXT NOT NULL,
  agent_id TEXT NOT NULL, repository TEXT NOT NULL, model TEXT,
  status TEXT NOT NULL, terminal INTEGER NOT NULL DEFAULT 0,
  usage_recorded INTEGER NOT NULL DEFAULT 0,
  created_at TEXT NOT NULL, updated_at TEXT NOT NULL,
  PRIMARY KEY (backend, run_id)
);

-- cloud_runs_session
CREATE INDEX cloud_runs_session ON cloud_runs (session_id);

-- memory
CREATE TABLE memory (
  id INTEGER PRIMARY KEY, project_slug TEXT NOT NULL, name TEXT NOT NULL, path TEXT NOT NULL,
  kind TEXT NOT NULL, updated_at TEXT NOT NULL, UNIQUE(project_slug, name)
);

-- memory_fts
CREATE VIRTUAL TABLE memory_fts USING fts5(name, body, project_slug UNINDEXED);

-- memory_fts_config
CREATE TABLE 'memory_fts_config'(k PRIMARY KEY, v) WITHOUT ROWID;

-- memory_fts_content
CREATE TABLE 'memory_fts_content'(id INTEGER PRIMARY KEY, c0, c1, c2);

-- memory_fts_data
CREATE TABLE 'memory_fts_data'(id INTEGER PRIMARY KEY, block BLOB);

-- memory_fts_docsize
CREATE TABLE 'memory_fts_docsize'(id INTEGER PRIMARY KEY, sz BLOB);

-- memory_fts_idx
CREATE TABLE 'memory_fts_idx'(segid, term, pgno, PRIMARY KEY(segid, term)) WITHOUT ROWID;

-- migrations
CREATE TABLE migrations (version INTEGER PRIMARY KEY, applied_at TEXT NOT NULL);

-- plugin_grants
CREATE TABLE plugin_grants (
  plugin_id TEXT NOT NULL, scope TEXT NOT NULL, digest TEXT NOT NULL,
  capabilities TEXT NOT NULL, enabled INTEGER NOT NULL, source TEXT NOT NULL,
  decided_at TEXT NOT NULL,
  PRIMARY KEY (plugin_id, scope, digest)
);

-- plugin_kv
CREATE TABLE plugin_kv (
  plugin_id TEXT NOT NULL, key TEXT NOT NULL, value BLOB NOT NULL, updated_at TEXT NOT NULL,
  PRIMARY KEY (plugin_id, key)
);

-- rollout_fts
CREATE VIRTUAL TABLE rollout_fts USING fts5(session_id UNINDEXED, turn UNINDEXED, text);

-- rollout_fts_config
CREATE TABLE 'rollout_fts_config'(k PRIMARY KEY, v) WITHOUT ROWID;

-- rollout_fts_content
CREATE TABLE 'rollout_fts_content'(id INTEGER PRIMARY KEY, c0, c1, c2);

-- rollout_fts_data
CREATE TABLE 'rollout_fts_data'(id INTEGER PRIMARY KEY, block BLOB);

-- rollout_fts_docsize
CREATE TABLE 'rollout_fts_docsize'(id INTEGER PRIMARY KEY, sz BLOB);

-- rollout_fts_idx
CREATE TABLE 'rollout_fts_idx'(segid, term, pgno, PRIMARY KEY(segid, term)) WITHOUT ROWID;

-- sessions
CREATE TABLE sessions (
  id TEXT PRIMARY KEY, created_at TEXT NOT NULL, updated_at TEXT NOT NULL,
  cwd TEXT NOT NULL, project_slug TEXT NOT NULL, title TEXT, parent_id TEXT,
  rollout_path TEXT NOT NULL, turns INTEGER NOT NULL DEFAULT 0,
  cost_usd REAL NOT NULL DEFAULT 0, state TEXT NOT NULL CHECK (state IN ('open','closed','error'))
, title_source TEXT, agent TEXT, agent_session TEXT);

-- usage
CREATE TABLE usage (
  id INTEGER PRIMARY KEY, session_id TEXT NOT NULL REFERENCES sessions(id), turn INTEGER NOT NULL,
  job TEXT NOT NULL, tier TEXT NOT NULL, provider TEXT NOT NULL, model TEXT NOT NULL,
  input_tokens INTEGER NOT NULL, output_tokens INTEGER NOT NULL,
  cache_read_tokens INTEGER NOT NULL, cache_write_tokens INTEGER NOT NULL,
  estimated INTEGER NOT NULL DEFAULT 0, cost_usd REAL NOT NULL, latency_ms INTEGER NOT NULL,
  context_tokens INTEGER NOT NULL,            -- what the model saw this call (for context-token-turns)
  created_at TEXT NOT NULL
, effort TEXT);

-- usage_day
CREATE INDEX usage_day ON usage(created_at);

-- usage_session
CREATE INDEX usage_session ON usage(session_id, turn);
